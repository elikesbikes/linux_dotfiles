#!/usr/bin/env bash
# CheckMK local check (tars): the Ollama container answers through Traefik, expected models are installed, which models are loaded, model folder size.
URL=https://tarsai.home.elikesbikes.com
t0=$(date +%s.%N)
ver="$(curl -s -m 8 -f $URL/api/version 2>/dev/null)" || { echo "2 \"Ollama API\" - not answering at $URL"; exit 0; }
ms=$(awk -v s="$t0" -v e="$(date +%s.%N)" 'BEGIN{printf "%d",(e-s)*1000}')
v="$(echo "$ver" | sed -n 's/.*"version":"\([^"]*\)".*/\1/p')"
tags="$(curl -s -m 8 $URL/api/tags 2>/dev/null)"; ps="$(curl -s -m 8 $URL/api/ps 2>/dev/null)"
miss=""; for m in qwen3:4b nomic-embed-text; do echo "$tags" | grep -q "\"$m" || miss="$miss $m"; done
loaded=$(echo "$ps" | grep -o '"name":"[^"]*"' | wc -l)
if [ -n "$miss" ]; then echo "1 \"Ollama API\" response_ms=$ms;1000;5000|models_loaded=$loaded version $v, missing model(s):$miss"
else echo "0 \"Ollama API\" response_ms=$ms;1000;5000|models_loaded=$loaded version $v, models present, $loaded loaded in memory, ${ms} ms"; fi
dir=/home/ecloaiza/devops/docker/ollama/models
[ -d "$dir" ] && { sz=$(du -sb "$dir" 2>/dev/null | cut -f1); echo "0 \"Ollama model storage\" size_bytes=$sz $(awk -v b="$sz" 'BEGIN{printf "%.1f GiB",b/1073741824}') in $dir"; }
