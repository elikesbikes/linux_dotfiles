#!/usr/bin/env python3
"""mr - open and check GitLab merge requests for the current repo (used by gacp_worktree_done).

Run inside a git checkout whose `origin` is on gitlab.home.elikesbikes.com.
Token: the GitLab credential helper (`git credential fill`), the same one git uses.
Every write is logged to syslog (tag `gitlab-mr`), which each host ships to Graylog.

  mr open   <branch> "title"   open an MR <branch> -> main, or refresh the open one (its title is kept,
                               the description is rewritten); prints its URL.
                               The description lists the branch's commits and repeats every
                               `Closes #N` / `Fixes #N` / `Resolves #N` found in their messages,
                               so the issues close when the MR is merged.
  mr status <branch>           newest MR from <branch>: prints "<state> <url>"
                               (opened / merged / closed / none); exit 0 for merged, 1 otherwise.
  mr merge  [--wait] <branch>  Merge the open MR from <branch> into main, which deploys the way a push
                               to main does. Refuses unless GitLab calls it mergeable (tests green, no
                               conflicts, not a draft). On a terminal it shows what will land and asks
                               y/N. Without a terminal (a Claude session) it merges only projects in
                               SESSION_MERGE below (owner 2026-11-22: the iOS apps, reviere, groceries);
                               mcc and every other project stay owner-only. --wait polls (30 s, up to
                               40 min) while the pipeline is still running. Exit 0 once merged.

Never put a secret in a title or commit message.
"""
import json
import re
import subprocess
import sys
import syslog
import urllib.error
import urllib.parse
import urllib.request

HOST = "gitlab.home.elikesbikes.com"
API = f"https://{HOST}/api/v4"
TARGET = "main"
# Projects a Claude session may merge without the owner (owner, 2026-11-22: "for the other repos, it is
# OK for you to merge"). An allowlist on purpose: a project not named here (mcc above all) needs the
# owner on a terminal. Deliberately not overridable by an environment variable or flag.
SESSION_MERGE = {
    "ecloaiza/chattars-ios", "ecloaiza/checkmktars-ios", "ecloaiza/cooper-ios", "ecloaiza/gittars-ios",
    "ecloaiza/groceries-ios", "ecloaiza/ntfytars-ios", "ecloaiza/openldap-ios", "ecloaiza/proxmoxtars-ios",
    "ecloaiza/reviere-ios", "ecloaiza/rsstars-ios", "ecloaiza/sshtars-ios",
    "ecloaiza/reviere", "ecloaiza/groceries",
}
WAITING = {"ci_still_running", "checking", "ci_must_pass", "preparing"}
CLOSES = re.compile(r"\b(?:close[sd]?|fix(?:e[sd])?|resolve[sd]?)\s+((?:[\w.-]+/)*[\w.-]*#\d+)", re.I)


def git(*args):
    return subprocess.run(["git", *args], capture_output=True, text=True, check=True).stdout.strip()


def project():
    url = git("remote", "get-url", "origin")
    m = re.match(rf"^(?:https://(?:[^@/]+@)?{re.escape(HOST)}/|git@{re.escape(HOST)}:)(.+?)(?:\.git)?/?$", url)
    if not m:
        sys.exit(f"mr: origin is not on {HOST} ({url}); merge requests need a GitLab origin")
    return m.group(1)


def token():
    try:
        out = subprocess.run(["git", "credential", "fill"], input=f"protocol=https\nhost={HOST}\n\n",
                             capture_output=True, text=True, timeout=60, check=True).stdout
    except (subprocess.SubprocessError, OSError) as err:
        sys.exit(f"mr: no GitLab credential ({err})")
    for line in out.splitlines():
        if line.startswith("password="):
            return line[len("password="):]
    sys.exit("mr: the credential helper returned no token for " + HOST)


TOKEN = None


def call(method, path, data=None):
    global TOKEN
    TOKEN = TOKEN or token()
    req = urllib.request.Request(f"{API}{path}", method=method,
                                 data=json.dumps(data).encode() if data is not None else None,
                                 headers={"PRIVATE-TOKEN": TOKEN, "Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            return json.loads(resp.read() or b"null")
    except urllib.error.HTTPError as err:
        detail = err.read()[:300].decode(errors="replace")
        sys.exit(f"mr: {method} {path} -> HTTP {err.code} {detail}")
    except urllib.error.URLError as err:
        sys.exit(f"mr: cannot reach {HOST}: {err.reason}")


def log(msg):
    syslog.openlog("gitlab-mr", 0, syslog.LOG_LOCAL0)
    syslog.syslog(syslog.LOG_INFO, msg)


def newest(pid, branch, state=None):
    q = {"source_branch": branch, "target_branch": TARGET, "order_by": "created_at", "per_page": 1}
    if state:
        q["state"] = state
    found = call("GET", f"/projects/{pid}/merge_requests?" + urllib.parse.urlencode(q))
    return found[0] if found else None


def description(branch):
    commits = git("log", "--no-merges", "--format=%h %s", f"origin/{TARGET}..{branch}")
    bodies = git("log", "--no-merges", "--format=%B", f"origin/{TARGET}..{branch}")
    refs = []
    for ref in CLOSES.findall(bodies):
        if ref not in refs:
            refs.append(ref)
    lines = ["Opened by `gacp_worktree_done`. Merging deploys the way a push to main does.", "", "**Commits**", ""]
    lines += [f"- {c}" for c in commits.splitlines()] or ["- (none)"]
    if refs:
        lines += ["", "**Issues**", ""] + [f"Closes {r}" for r in refs]
    return "\n".join(lines)


def cmd_open(branch, title):
    title = (title.strip().splitlines() or [branch])[0][:255]
    path = project()
    pid = urllib.parse.quote(path, safe="")
    body = description(branch)
    mr = newest(pid, branch, "opened")
    if mr:
        # Keep the title the MR was opened with (or edited to in GitLab); only the commit list grows.
        mr = call("PUT", f"/projects/{pid}/merge_requests/{mr['iid']}", {"description": body})
        verb = "updated"
    else:
        mr = call("POST", f"/projects/{pid}/merge_requests", {
            "source_branch": branch, "target_branch": TARGET, "title": title,
            "description": body, "remove_source_branch": True})
        verb = "opened"
    log(f"MR_{verb.upper()}: project={path} mr=!{mr['iid']} branch={branch}")
    print(f"{verb} !{mr['iid']}  {mr['web_url']}")


def cmd_status(branch):
    path = project()
    mr = newest(urllib.parse.quote(path, safe=""), branch)
    if not mr:
        print("none")
        return 1
    print(f"{mr['state']} {mr['web_url']}")
    return 0 if mr["state"] == "merged" else 1


def cmd_merge(branch, wait=False):
    # A merge deploys. On a terminal the owner confirms y/N. Without one (a Claude session) only the
    # SESSION_MERGE projects merge; there is no flag or environment override for the rest.
    interactive = sys.stdin.isatty() and sys.stdout.isatty()
    path = project()
    if not interactive and path not in SESSION_MERGE:
        sys.exit(f"mr merge: {path} is owner-only; the owner merges it on a terminal or with the Merge button")
    pid = urllib.parse.quote(path, safe="")
    mr = newest(pid, branch, "opened")
    if not mr:
        sys.exit(f"mr merge: no open merge request from {branch}; open it first (gacp_branch_done / gacp_worktree_done), or it is already merged")
    deadline = time.time() + 40 * 60
    while True:
        mr = call("GET", f"/projects/{pid}/merge_requests/{mr['iid']}")
        status = mr.get("detailed_merge_status")
        pipe = mr.get("head_pipeline") or {}
        if not (wait and status in WAITING and pipe.get("status") not in ("failed", "canceled", "skipped")
                and time.time() < deadline):
            break
        print(f"    waiting: !{mr['iid']} {status}, pipeline {pipe.get('id')} {pipe.get('status')}", flush=True)
        time.sleep(30)
    if status != "mergeable":
        hint = {"ci_must_pass": "the tests have not passed yet", "ci_still_running": "the tests are still running",
                "checking": "GitLab is still checking it, try again in a moment", "conflict": "it has merge conflicts",
                "need_rebase": "it needs main merged in (run gacp_worktree_done again)", "draft_status": "it is a draft",
                "not_approved": "it needs an approval", "discussions_not_resolved": "it has open threads"}.get(status, status)
        sys.exit(f"mr merge: !{mr['iid']} cannot be merged: {hint} (pipeline {pipe.get('id')} {pipe.get('status')})\n  {mr['web_url']}")
    commits = call("GET", f"/projects/{pid}/merge_requests/{mr['iid']}/commits?per_page=50")
    print(f"!{mr['iid']}  {mr['title']}")
    print(f"    {mr['web_url']}")
    print(f"    {branch} -> {TARGET}, pipeline {pipe.get('id')} {pipe.get('status')}")
    for c in commits:
        print(f"    {c['short_id']} {c['title']}")
    ans = input(f"Merge !{mr['iid']} into {TARGET}? This deploys (rocky for mcc). [y/N] ").strip()
    if ans not in ("y", "Y"):
        print("Not merged.")
        return 1
    # sha pins the merge to what was shown: a push in between makes GitLab refuse instead of merging unseen work.
    done = call("PUT", f"/projects/{pid}/merge_requests/{mr['iid']}/merge",
                {"sha": mr["sha"], "should_remove_source_branch": True})
    log(f"MR_MERGED: project={path} mr=!{mr['iid']} branch={branch} sha={mr['sha'][:12]}")
    print(f"merged !{mr['iid']}  {done.get('web_url', mr['web_url'])}")
    return 0 if done.get("state") == "merged" else 1


def main(argv):
    if len(argv) == 3 and argv[0] == "open":
        cmd_open(argv[1], argv[2])
        return 0
    if len(argv) == 2 and argv[0] == "status":
        return cmd_status(argv[1])
    if len(argv) == 2 and argv[0] == "merge":
        return cmd_merge(argv[1])
    sys.exit(__doc__)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
