# ------------------------------------------------------------------ Chat View: sessions, transcript, prompt

SESSIONS = STATE / "sessions"
PROJECTS = Path.home() / ".claude/projects"
SESSION_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9-]{7,79}$")
RECENT_S = 3 * 86400


def record_session(data, target):
    """Remember which terminal a Claude Code session runs in, so `prompt` can type into it later."""
    sid = data.get("session_id") or ""
    if not SESSION_RE.match(sid) or data.get("agent_id"):
        return
    try:
        SESSIONS.mkdir(parents=True, exist_ok=True)
        tmp = SESSIONS / f".{sid}.tmp"
        title = data.get("session_title") or (registry_entry(sid) or {}).get("title")
        tmp.write_text(json.dumps({"session": sid, "transcript": data.get("transcript_path"), "cwd": data.get("cwd"),
                                   "terminal": target, "title": title, "ts": round(time.time(), 3)}))
        tmp.replace(SESSIONS / f"{sid}.json")
    except OSError as e:
        log("session-record-failed", error=str(e))


QUESTIONS = STATE / "questions"
QUESTION_TTL_S = 24 * 3600


def record_question(data):
    """PreToolUse for AskUserQuestion: keep the open question, which the transcript gets only once it is
    answered. One file per session, replaced by the next question."""
    sid = data.get("session_id") or ""
    if data.get("tool_name") != "AskUserQuestion" or not SESSION_RE.match(sid) or data.get("agent_id"):
        return
    questions = question_row(data.get("tool_input"))
    if not questions or not data.get("tool_use_id"):
        return
    try:
        QUESTIONS.mkdir(parents=True, exist_ok=True)
        tmp = QUESTIONS / f".{sid}.tmp"
        tmp.write_text(json.dumps({"session": sid, "id": data["tool_use_id"], "questions": questions,
                                   "ts": round(time.time(), 3)}, ensure_ascii=False))
        tmp.replace(QUESTIONS / f"{sid}.json")
    except OSError as e:
        log("question-record-failed", error=str(e))


def open_question(sid: str, seen: set, last_prompt: float):
    """The question the session is showing now, as a transcript row; None when its tool call is in the
    transcript (answered or cancelled), a prompt was typed after it, or it is a day old."""
    try:
        q = json.loads((QUESTIONS / f"{sid}.json").read_text())
    except (OSError, ValueError):
        return None
    if q.get("id") in seen or q.get("ts", 0) < last_prompt or time.time() - q.get("ts", 0) > QUESTION_TTL_S:
        return None
    return {"id": q["id"], "role": "question", "tool": "AskUserQuestion", "text": q["questions"][0]["question"],
            "ok": None, "questions": q["questions"], "answers": []}


def registry_entry(sid: str):
    try:
        return json.loads((SESSIONS / f"{sid}.json").read_text())
    except (OSError, ValueError):
        return None


def registry() -> dict:
    out = {}
    for f in SESSIONS.glob("*.json") if SESSIONS.exists() else []:
        try:
            entry = json.loads(f.read_text())
            out[entry["session"]] = entry
        except (OSError, ValueError, KeyError):
            continue
    return out


def transcript_path(sid: str, reg=None):
    entry = (reg if reg is not None else registry()).get(sid) or {}
    path = entry.get("transcript")
    if path and Path(path).is_file():
        return Path(path)
    for p in PROJECTS.glob(f"*/{sid}.jsonl"):
        return p
    return None


def tail_rows(path: Path, max_bytes: int) -> list:
    """The JSONL's last max_bytes as parsed rows (the first, partial line dropped when cut)."""
    with open(path, "rb") as f:
        f.seek(0, os.SEEK_END)
        size = f.tell()
        f.seek(max(0, size - max_bytes))
        lines = f.read().split(b"\n")
    if size > max_bytes:
        lines = lines[1:]
    rows = []
    for line in lines:
        try:
            rows.append(json.loads(line))
        except ValueError:
            continue
    return rows


REMINDER_RE = re.compile(r"<system-reminder>.*?</system-reminder>", re.S)


def tool_summary(name: str, value) -> str:
    """One line for a tool call: the command, path, pattern or URL it was given."""
    value = value if isinstance(value, dict) else {}
    keys = {"Bash": "command", "Read": "file_path", "Edit": "file_path", "Write": "file_path", "MultiEdit": "file_path",
            "NotebookEdit": "notebook_path", "Grep": "pattern", "Glob": "pattern", "WebFetch": "url", "WebSearch": "query",
            "Task": "description", "Agent": "description", "Skill": "skill", "TodoWrite": None}
    key = keys.get(name, "")
    text = value.get(key) if key else None
    if text is None and key == "":
        text = next((v for v in value.values() if isinstance(v, str)), "")
    return " ".join(str(text or "").split())[:200]


def question_row(value) -> list:
    """AskUserQuestion's input as [{"question", "header", "multi", "options": [{"label", "description",
    "preview"}]}], trimmed so one long preview cannot fill the reply."""
    out = []
    for q in (value.get("questions") if isinstance(value, dict) else None) or []:
        if not isinstance(q, dict):
            continue
        options = []
        for o in q.get("options") or []:
            if isinstance(o, dict) and o.get("label"):
                options.append({"label": str(o["label"])[:120], "description": str(o.get("description") or "")[:400],
                                "preview": str(o.get("preview") or "")[:2000] or None})
        out.append({"question": str(q.get("question") or "")[:600], "header": str(q.get("header") or "")[:40],
                    "multi": bool(q.get("multiSelect")), "options": options})
    return out


def question_answers(questions: list, result) -> list:
    """The answers Claude Code recorded ({question: answer}), in the questions' order."""
    given = result.get("answers") if isinstance(result, dict) else None
    if not isinstance(given, dict):
        return []
    return [{"question": q["question"], "answer": str(given[q["question"]])[:600]}
            for q in questions if q["question"] in given]


def row_time(row) -> float:
    """A transcript row's ISO timestamp as epoch seconds; 0 when it has none."""
    text = str((row or {}).get("timestamp") or "")
    try:
        return float(calendar.timegm(time.strptime(text[:19], "%Y-%m-%dT%H:%M:%S")))     # the rows are UTC
    except ValueError:
        return 0.0


def subagents(folder, wanted) -> dict:
    """Claude Code's record of a session's sub-agents (`<session>/subagents/agent-<id>.meta.json` and
    `.jsonl` beside the transcript), by the tool call that started each: its type, model, whether it has
    finished and how long it ran (first to last line of its own transcript; to now while it runs). Only
    the tool calls in `wanted` are read."""
    out = {}
    for meta_path in Path(folder).glob("agent-*.meta.json") if wanted and Path(folder).is_dir() else []:
        try:
            meta = json.loads(meta_path.read_text())
            if meta.get("toolUseId") not in wanted:
                continue
            log = meta_path.with_name(meta_path.name[:-len(".meta.json")] + ".jsonl")
            with open(log, "rb") as f:
                first = json.loads(f.readline(2_000_000) or b"{}")
            tail = tail_rows(log, 200_000)
            last = tail[-1] if tail else first
            mtime = log.stat().st_mtime
        except (OSError, ValueError):
            continue
        finished = bool(meta.get("finished"))
        running = not finished and time.time() - mtime < 600      # stopped writing 10 min ago: not running
        start, end = row_time(first), (time.time() if running else row_time(last))
        model = meta.get("pickedEffortModel") or next(
            ((r.get("message") or {}).get("model") for r in reversed(tail) if r.get("type") == "assistant"), None)
        out[meta.get("toolUseId")] = {
            "type": meta.get("agentType"), "model": model if model and not str(model).startswith("<") else None,
            "state": "finished" if finished else ("running" if running else "stopped"),
            "seconds": round(end - start) if start and end >= start else None}
    return out


def reduce_transcript(rows: list, limit: int, agents=None) -> dict:
    """Claude Code JSONL rows → title, model, branch, state and the last `limit` chat rows. `agents`
    (tool call ids → subagents()) describes the Agent tool calls among the rows that are kept."""
    msgs, tools = [], {}
    last_prompt = 0.0
    title = prompt_title = model = branch = cwd = context = None
    state = "idle"
    for r in rows:
        kind = r.get("type")
        if kind == "custom-title":
            title = r.get("customTitle") or title
            continue
        if kind == "last-prompt":
            prompt_title = r.get("lastPrompt") or prompt_title
            continue
        if kind not in ("user", "assistant") or r.get("isSidechain"):
            continue
        cwd = r.get("cwd") or cwd
        branch = r.get("gitBranch") or branch
        message = r.get("message") or {}
        content = message.get("content")
        ts = r.get("timestamp")
        uid = r.get("uuid") or str(len(msgs))
        if kind == "user":
            if r.get("isMeta"):
                continue
            blocks = content if isinstance(content, list) else []
            for b in blocks:
                if isinstance(b, dict) and b.get("type") == "tool_result":
                    tool = tools.get(b.get("tool_use_id"))
                    if tool is not None:
                        tool["ok"] = not b.get("is_error")
                        if tool["role"] == "question":
                            tool["answers"] = question_answers(tool["questions"], r.get("toolUseResult"))
                        elif tool.get("agent") is not None and isinstance(r.get("toolUseResult"), dict):
                            result = r["toolUseResult"]
                            tool["agent"]["model"] = tool["agent"]["model"] or result.get("resolvedModel")
                            if isinstance(result.get("totalDurationMs"), (int, float)):    # ran in the foreground
                                tool["agent"].update(seconds=round(result["totalDurationMs"] / 1000), state="finished")
                    state = "working"
            text = content if isinstance(content, str) else "\n".join(
                b.get("text", "") for b in blocks if isinstance(b, dict) and b.get("type") == "text")
            text = REMINDER_RE.sub("", text).strip()
            if text and not text.startswith("<"):
                msgs.append({"id": uid, "role": "user", "text": text[:4000], "ts": ts})
                last_prompt = row_time(r)
                state = "working"
            continue
        model = message.get("model") or model
        usage = message.get("usage")
        if isinstance(usage, dict):         # tokens the model saw this turn = how full the context is
            seen = sum(int(usage.get(k) or 0) for k in
                       ("input_tokens", "cache_creation_input_tokens", "cache_read_input_tokens"))
            context = seen or context
        for i, b in enumerate(content if isinstance(content, list) else []):
            if not isinstance(b, dict):
                continue
            if b.get("type") == "text" and b.get("text", "").strip():
                text = REMINDER_RE.sub("", b["text"]).strip()
                if msgs and msgs[-1]["role"] == "assistant" and msgs[-1].get("mid") == message.get("id"):
                    msgs[-1]["text"] = (msgs[-1]["text"] + "\n\n" + text)[:8000]
                else:
                    msgs.append({"id": f"{uid}.{i}", "role": "assistant", "text": text[:8000], "ts": ts, "mid": message.get("id")})
            elif b.get("type") == "tool_use":
                name, value = b.get("name") or "tool", b.get("input")
                row = {"id": f"{uid}.{i}", "role": "tool", "tool": name,
                       "text": tool_summary(name, value), "ok": None, "ts": ts}
                if name == "AskUserQuestion" and question_row(value):
                    row.update(role="question", questions=question_row(value), answers=[])
                    row["text"] = row["questions"][0]["question"]
                elif name in ("Agent", "Task"):
                    value = value if isinstance(value, dict) else {}
                    row["agent"] = {"type": value.get("subagent_type"), "model": value.get("model"),
                                    "state": None, "seconds": None}
                    row["use"] = b.get("id")
                tools[b.get("id")] = row
                msgs.append(row)
        stop = message.get("stop_reason")
        if stop:
            state = "working" if stop == "tool_use" else "idle"
    first_prompt = next((m["text"] for m in msgs if m["role"] == "user"), None)
    msgs = msgs[-limit:]
    started = {m["use"]: m for m in msgs if m.get("use")}
    for use, known in (agents(set(started)) if agents and started else {}).items():
        if use in started:
            started[use]["agent"].update({k: v for k, v in known.items() if v is not None})
    for m in msgs:
        m.pop("mid", None)
        m.pop("use", None)
    if msgs and msgs[-1]["role"] == "question" and msgs[-1]["ok"] is None:
        state = "asking"                    # Claude Code is showing the question and waiting
    if model and model.startswith("<"):
        model = None
    return {"title": title or prompt_title or first_prompt, "model": model, "branch": branch, "cwd": cwd,
            "state": state, "context": context, "messages": msgs, "seen": set(tools), "last_prompt": last_prompt}


def session_info(sid: str, path: Path, reg: dict, rows_bytes: int, limit: int, details=False) -> dict:
    folder = path.with_suffix("") / "subagents"
    info = reduce_transcript(tail_rows(path, rows_bytes), limit,
                             (lambda wanted: subagents(folder, wanted)) if details else None)
    asked = open_question(sid, info.pop("seen"), info.pop("last_prompt"))
    if asked:
        info["messages"].append(asked)
        info["state"] = "asking"
    mtime = path.stat().st_mtime
    if info["state"] == "working" and time.time() - mtime > 600:
        info["state"] = "idle"              # a turn that stopped writing 10 min ago is not running
    term = (reg.get(sid) or {}).get("terminal")
    title = " ".join((info["title"] or "").split())[:120]
    return {"session": sid, "title": title, "cwd": info["cwd"], "project": Path(info["cwd"] or "").name or None,
            "model": info["model"], "branch": info["branch"], "state": info["state"], "updated": round(mtime, 3),
            "context": info["context"],
            "terminal": term, "where": describe(term) if term else None, "messages": info["messages"]}


def cmd_sessions(args):
    reg = registry()
    found = {}
    for sid in reg:
        path = transcript_path(sid, reg)
        if path:
            found[sid] = path
    cutoff = time.time() - RECENT_S
    for p in PROJECTS.glob("*/*.jsonl") if PROJECTS.exists() else []:
        try:
            if p.stat().st_mtime >= cutoff and SESSION_RE.match(p.stem):
                found.setdefault(p.stem, p)
        except OSError:
            continue
    ordered = sorted(found.items(), key=lambda kv: kv[1].stat().st_mtime, reverse=True)[:args.limit]
    out = []
    for sid, path in ordered:
        try:
            info = session_info(sid, path, reg, 400_000, 30)
        except (OSError, ValueError) as e:
            log("session-read-failed", session=sid, error=str(e))
            continue
        said = [m for m in info.pop("messages") if m["role"] != "tool"]
        info["last"] = " ".join(said[-1]["text"].split())[:200] if said else None
        out.append(info)
    if args.json:
        print(json.dumps({"version": VERSION, "sessions": out}, ensure_ascii=False))
    else:
        for s in out:
            print(f"{s['session'][:8]}  {s['state']:7}  {s['where'] or '-':32}  {s['title']}")
    return 0


def cmd_transcript(args):
    if not SESSION_RE.match(args.session):
        print(json.dumps({"error": "bad session id"})); return 2
    reg = registry()
    path = transcript_path(args.session, reg)
    if not path:
        print(json.dumps({"error": "no transcript for this session"})); return 1
    info = session_info(args.session, path, reg, 3_000_000, max(1, min(args.limit, 300)), details=True)
    print(json.dumps({"version": VERSION, **info}, ensure_ascii=False))
    return 0


CONTROL_RE = re.compile(r"[\x00-\x1f\x7f]")


def type_into(term: dict, text: str):
    """Type text into the terminal and press Enter: the same thing a person at the keyboard does."""
    if term["kind"] == "tmux":
        tmux("send-keys", "-t", term["pane"], "-l", text)
        tmux("send-keys", "-t", term["pane"], "Enter")
    elif term["kind"] == "hc":
        run(["hc", "send", term["pane"], text])
    else:
        session = term.get("session") or "default"
        herdr = ["herdr"] if session == "default" else ["herdr", "--session", session]
        run([*herdr, "pane", "send-text", term["pane"], text])
        run([*herdr, "pane", "send-keys", term["pane"], "enter"])


def cmd_prompt(args):
    if not SESSION_RE.match(args.session):
        print("bad session id", file=sys.stderr); return 2
    text = " ".join(CONTROL_RE.sub(" ", args.text).split())
    if not text:
        print("nothing to send", file=sys.stderr); return 2
    term = (registry().get(args.session) or {}).get("terminal")
    if not term:
        print("no terminal known for this session yet (recorded when one of its turns ends)", file=sys.stderr)
        return 1
    try:
        type_into(term, text[:4000])
    except _FAILS as e:
        log("prompt-failed", session=args.session, error=str(e))
        print(f"could not type into {describe(term)}: {e}", file=sys.stderr)
        return 1
    log("prompt-sent", session=args.session, terminal=describe(term), chars=len(text))
    print(json.dumps({"ok": True, "where": describe(term)}))
    return 0


# Answering a question (1.7.0). Claude Code's AskUserQuestion prompt, as checked against 2.1.322:
#   - options are numbered; a digit picks that option, and with option previews on screen it only moves
#     the highlight, so Enter follows;
#   - a question that takes several answers toggles each digit's box, and Tab moves on;
#   - with more than one question (or a several-answer one) a review page ends it: "1. Submit answers".
# Like the approval watcher, keys go in only while the screen shows what is expected.

QUESTION_FOOT = "Enter to select"
TAB_MARK_RE = re.compile(r"[☐☒]")
CHOSEN_RE = re.compile(r"^\s*❯\s*(\d+)\.")


def herdr_argv(term) -> list:
    session = term.get("session") or "default"
    return ["herdr"] if session == "default" else ["herdr", "--session", session]


def read_screen(term) -> list:
    """screen(), for a caller outside the agent's own environment (the app's SSH command)."""
    if term["kind"] == "herdr":
        return run([*herdr_argv(term), "pane", "read", term["pane"], "--source", "visible"]).splitlines()
    return screen(term)


def press_key(term, key: str):
    """key: "enter", "tab" or one character."""
    named = {"enter": "Enter", "tab": "Tab"}
    if term["kind"] == "tmux":
        tmux("send-keys", "-t", term["pane"], *([named[key]] if key in named else ["-l", key]))
    elif term["kind"] == "hc":
        run(["hc", "keys", term["pane"], key])
    elif key in named:
        run([*herdr_argv(term), "pane", "send-keys", term["pane"], key])
    else:
        run([*herdr_argv(term), "pane", "send-text", term["pane"], key])


def squash(text: str) -> str:
    return " ".join(text.split())


def question_view(lines: list):
    """What the question prompt shows, or None when there is none on screen: {"marks": the tab line's
    boxes ("☐" open, "☒" answered), "chosen": the highlighted option's number, "options": {number: its
    line's text}, "review": the Submit page is showing}."""
    foot = [i for i, line in enumerate(lines) if QUESTION_FOOT in line]
    review = any("Submit answers" in line for line in lines)
    if not foot and not review:
        return None
    body = lines[:foot[-1]] if foot else lines
    tabs = [line for line in body if TAB_MARK_RE.search(line) and "[" not in line]
    options, chosen = {}, None
    for line in body:
        m = re.match(r"^\s*(❯)?\s*(\d+)\.\s+(.*)$", line)
        if m:
            options[int(m.group(2))] = squash(m.group(3))
            if m.group(1):
                chosen = int(m.group(2))
    return {"marks": TAB_MARK_RE.findall(tabs[-1]) if tabs else [], "chosen": chosen, "options": options,
            "review": review}


def shows(view, index: int, question: dict) -> bool:
    """Is this the question on screen, still open? Its tab box is open and its first options are listed
    under their numbers (a checkbox, then the label, which a narrow terminal may cut short)."""
    if not view or view["review"]:
        return False
    if index < len(view["marks"]) and view["marks"][index] != "☐":
        return False
    for n, option in enumerate(question["options"], 1):
        shown = re.sub(r"^\[.\]\s*", "", view["options"].get(n, "")).rstrip("… ")
        label = squash(option["label"])
        size = min(len(shown), len(label), 24)
        if not size or shown[:size] != label[:size]:
            return False
    return bool(question["options"])


def wait_view(term, test, seconds=4.0):
    """The first question_view() that passes `test`, polling the screen; None when none does in time."""
    deadline = time.time() + seconds
    while True:
        view = question_view(read_screen(term))
        if test(view):
            return view
        if time.time() >= deadline:
            return None
        time.sleep(0.3)


def parse_choices(texts: list, questions: list) -> list:
    """["2", "1,3"] → [[2], [1, 3]], checked against the questions (count, range, one answer unless multi)."""
    if len(texts) != len(questions):
        raise ValueError(f"{len(questions)} question(s) asked, {len(texts)} answer(s) given")
    out = []
    for text, q in zip(texts, questions):
        tokens = [t.strip() for t in text.split(",")]
        if not all(t.isdigit() for t in tokens) or len(set(tokens)) != len(tokens):
            raise ValueError(f"bad answer {text!r}: option numbers, joined by commas")
        picks = sorted(int(t) for t in tokens)
        if picks[0] < 1 or picks[-1] > len(q["options"]):
            raise ValueError(f"{q['header'] or 'the question'} has options 1 to {len(q['options'])}")
        if len(picks) > 1 and not q["multi"]:
            raise ValueError(f"{q['header'] or 'the question'} takes one answer")
        out.append(picks)
    return out


def answer_question(term, questions: list, choices: list):
    """Presses the answers into the prompt. Raises RuntimeError, having pressed nothing more, as soon as
    the screen is not the question it expects."""
    for index, (q, picks) in enumerate(zip(questions, choices)):
        view = wait_view(term, lambda v: shows(v, index, q))
        if not view:
            raise RuntimeError(f"question {index + 1} is not on the terminal's screen" if index else
                               "the question is not on the terminal's screen")
        if q["multi"]:
            for n in picks:
                if not view["options"].get(n, "").startswith("[✔]"):
                    press_key(term, str(n))
                    time.sleep(0.25)
            press_key(term, "tab")
            continue
        press_key(term, str(picks[0]))
        time.sleep(0.5)
        view = question_view(read_screen(term))
        if shows(view, index, q) and view["chosen"] == picks[0]:      # previews on screen: the digit only moved
            press_key(term, "enter")
    if len(questions) > 1 or questions[-1]["multi"]:
        view = wait_view(term, lambda v: v is None or v["review"])
        if view and view["review"]:
            if view["chosen"] != 1 or "Submit" not in view["options"].get(1, ""):
                raise RuntimeError("the review page is not on Submit answers; finish it in the terminal")
            press_key(term, "1")
        elif view is not None:
            raise RuntimeError("the answers were pressed but the prompt is still open; finish it in the terminal")


def cmd_answer(args):
    if not SESSION_RE.match(args.session):
        print("bad session id", file=sys.stderr); return 2
    reg = registry()
    term = (reg.get(args.session) or {}).get("terminal")
    path = transcript_path(args.session, reg)
    if not term or not path:
        print("no terminal known for this session yet (recorded when one of its turns ends)", file=sys.stderr)
        return 1
    messages = session_info(args.session, path, reg, 1_000_000, 40)["messages"]
    asked = messages[-1] if messages and messages[-1]["role"] == "question" and messages[-1]["ok"] is None else None
    if not asked:
        print("this session is not asking a question now", file=sys.stderr); return 1
    if args.id and args.id != asked["id"]:
        print("the session has moved on to another question; reload it", file=sys.stderr); return 1
    try:
        choices = parse_choices(args.choices, asked["questions"])
        answer_question(term, asked["questions"], choices)
    except ValueError as e:
        print(str(e), file=sys.stderr); return 2
    except _FAILS as e:
        log("answer-failed", session=args.session, error=str(e))
        print(f"could not answer in {describe(term)}: {e}", file=sys.stderr)
        return 1
    log("answer-sent", session=args.session, terminal=describe(term), questions=len(choices))
    print(json.dumps({"ok": True, "where": describe(term)}))
    return 0


def last_logged():
    """The newest line of hook.log as {ts, outcome}, reading only the file's tail."""
    try:
        with open(LOG, "rb") as f:
            f.seek(0, os.SEEK_END)
            size = f.tell()
            f.seek(max(0, size - 4096))
            lines = f.read().decode("utf-8", "replace").strip().splitlines()
        for line in reversed(lines):
            try:
                row = json.loads(line)
                return {"ts": row.get("ts"), "outcome": row.get("outcome")}
            except ValueError:
                continue
    except OSError:
        pass
    return None


def cmd_status(args):
