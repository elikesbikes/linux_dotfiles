# ------------------------------------------------------------------ diff view, web preview, usage (1.6.0)
#
# Moshi's diff viewer, Browser Preview and usage cards (docs/moshi-teardown.md §6, Hooks), as one-shot
# commands the app runs over its own SSH connection. Nothing here talks to MCC.

DIFF_MAX_BYTES = 600_000        # patch text in one reply; past it, files keep their counts and lose the patch
DIFF_MAX_FILES = 300
UNTRACKED_MAX_BYTES = 64_000    # an untracked file is shown whole (as added lines) up to this size
EMPTY_TREE = "4b825dc642cb6eb9a060e54bf8d69288fbee4904"


def git(cwd: str, *args, timeout=10) -> str:
    # Fixed output whatever the user's git config says (diff.mnemonicPrefix, quotepath, external diff).
    return run(["git", "-c", "core.quotepath=false", "-C", cwd, *args], timeout)


def unquote_path(path: str) -> str:
    """git C-quotes paths with unusual bytes ("a\\tb"); good enough for display and matching."""
    if len(path) >= 2 and path[0] == path[-1] == '"':
        return path[1:-1].encode("latin-1", "backslashreplace").decode("unicode_escape").encode("latin-1").decode("utf-8", "replace")
    return path


def parse_porcelain(text: str) -> list:
    """`git status --porcelain=v1 -z --no-renames`: [(status letter, path)]."""
    out = []
    for entry in text.split("\0"):
        if len(entry) < 4:
            continue
        xy, path = entry[:2], entry[3:]
        if xy == "??":
            status = "?"
        elif "U" in xy or xy in ("AA", "DD"):
            status = "U"
        elif "D" in xy:
            status = "D"
        elif "A" in xy:
            status = "A"
        else:
            status = "M"
        out.append((status, path))
    return out


def parse_numstat(text: str) -> dict:
    """`git diff --numstat --no-renames`: path → (added, removed), None for a binary file."""
    stats = {}
    for line in text.splitlines():
        parts = line.split("\t", 2)
        if len(parts) != 3:
            continue
        added, removed, path = parts
        stats[unquote_path(path)] = None if added == "-" else (int(added), int(removed))
    return stats


def split_patch(text: str) -> dict:
    """One `git diff` output → path → that file's patch (from its `diff --git` line)."""
    patches, current, path = {}, [], None

    def flush():
        if path is not None and current:
            patches[path] = "".join(current)

    for line in text.splitlines(keepends=True):
        if line.startswith("diff --git "):
            flush()
            current, path = [line], None
            continue
        if path is None and current and (line.startswith("+++ ") or line.startswith("--- ")):
            name = unquote_path(line[4:].rstrip("\n").rstrip("\t"))   # git adds a tab after names with spaces
            if name != "/dev/null" and name[:2] in ("a/", "b/"):
                if line.startswith("+++ ") or not path:
                    path = name[2:]
        if path is None and current and line.startswith("Binary files "):
            m = re.match(r"Binary files (?:a/)?(.+?) and (?:b/)?(.+?) differ", line)
            if m:
                path = unquote_path(m.group(2) if m.group(2) != "/dev/null" else m.group(1))
        if current:
            current.append(line)
    flush()
    return patches


def untracked_patch(root: str, path: str):
    """An untracked text file as a patch of added lines; (patch, added) or (None, None) when binary or big."""
    try:
        full = Path(root) / path
        if full.is_symlink() or not full.is_file() or full.stat().st_size > UNTRACKED_MAX_BYTES:
            return None, None
        data = full.read_bytes()
    except OSError:
        return None, None
    if b"\0" in data:
        return None, None
    lines = data.decode("utf-8", "replace").splitlines()
    body = "".join(f"+{l}\n" for l in lines)
    return f"--- /dev/null\n+++ b/{path}\n@@ -0,0 +1,{len(lines)} @@\n{body}", len(lines)


def diff_report(cwd: str) -> dict:
    cwd = os.path.realpath(os.path.expanduser(cwd))
    if not os.path.isdir(cwd):
        raise RuntimeError(f"{cwd} is not a directory")
    try:
        root = git(cwd, "rev-parse", "--show-toplevel").strip()
    except RuntimeError:
        return {"git": False, "cwd": cwd, "root": cwd, "files": []}
    try:
        git(root, "rev-parse", "--verify", "-q", "HEAD")
        base, head = "HEAD", git(root, "log", "-1", "--format=%h %s").strip()
    except RuntimeError:
        base, head = EMPTY_TREE, None
    branch = git(root, "rev-parse", "--abbrev-ref", "HEAD").strip() if head else None
    ahead = behind = None
    if head:
        try:
            counts = git(root, "rev-list", "--left-right", "--count", "@{upstream}...HEAD").split()
            behind, ahead = int(counts[0]), int(counts[1])
        except (RuntimeError, ValueError, IndexError):
            pass
    status = parse_porcelain(git(root, "status", "--porcelain=v1", "-z", "--no-renames", "--untracked-files=all", timeout=20))
    stats = parse_numstat(git(root, "diff", base, "--numstat", "--no-renames", "--no-ext-diff", timeout=20))
    patches = split_patch(git(root, "diff", base, "--no-color", "--no-ext-diff", "--no-renames", "--src-prefix=a/", "--dst-prefix=b/", timeout=30))
    files, used, truncated = [], 0, len(status) > DIFF_MAX_FILES
    for code, path in status[:DIFF_MAX_FILES]:
        entry = {"path": path, "status": code, "added": 0, "removed": 0, "binary": False, "patch": None}
        if code == "?":
            patch, added = untracked_patch(root, path)
            entry["added"] = added or 0
            entry["binary"] = patch is None and added is None and (Path(root) / path).is_file() \
                and (Path(root) / path).stat().st_size <= UNTRACKED_MAX_BYTES
        else:
            counts = stats.get(path, (0, 0))
            if counts is None:
                entry["binary"] = True
            else:
                entry["added"], entry["removed"] = counts
            patch = patches.get(path)
        if patch is not None:
            if used + len(patch) <= DIFF_MAX_BYTES:
                entry["patch"], used = patch, used + len(patch)
            else:
                truncated = True
        files.append(entry)
    return {"git": True, "cwd": cwd, "root": root, "branch": branch, "head": head, "ahead": ahead,
            "behind": behind, "files": files, "truncated": truncated}


def cmd_diff(args):
    try:
        if args.tmux:
            cwd = tmux("display-message", "-p", "-t", args.tmux, "#{pane_current_path}").strip()
