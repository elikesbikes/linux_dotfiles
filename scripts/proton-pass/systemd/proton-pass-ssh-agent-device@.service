[Unit]
Description=Proton Pass SSH agent for SSHTars device %i (HOMELAB, socket sshtars-%i.sock)
After=default.target proton-pass-ssh-agent.service

[Service]
Type=simple
ExecStart=%h/scripts/proton-pass/ssh-agent-start.sh --device %i
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
