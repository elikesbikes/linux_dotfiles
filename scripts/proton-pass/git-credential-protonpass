#!/usr/bin/env bash
# Git credential helper that reads credentials from Proton Pass via PAT
# # Emmanuel Comment

if [ "$1" != "get" ]; then
    exit 0
fi

host=""
while IFS='=' read -r key value; do
    case "$key" in
        host) host="$value" ;;
    esac
done

case "$host" in
    github.com)
        item_title="github.com - git credential"
        username="elikesbikes"
        field="password"
        ;;
    gitlab.home.elikesbikes.com)
        item_title="gitlab.home.elikesbikes.com - git credential"
        username="ecloaiza"
        field="note"
        ;;
    *)
        exit 0
        ;;
esac

PASS_CLI="$HOME/.local/bin/pass-cli"
PAT_FILE="$HOME/.secrets/proton-pass-pat"
TPM_HANDLE="0x81010001"
export PROTON_PASS_KEY_PROVIDER=fs
export PROTON_PASS_SESSION_DIR="/tmp/pass-agent-git"
mkdir -p "$PROTON_PASS_SESSION_DIR"

get_pat() {
    if command -v tpm2_unseal &>/dev/null && tpm2_unseal -c "$TPM_HANDLE" 2>/dev/null; then
        return
    fi
    if [[ -f "$PAT_FILE" ]]; then
        cat "$PAT_FILE"
        return
    fi
    exit 1
}

if ! "$PASS_CLI" info &>/dev/null; then
    # --force: a plain logout fails on an undecryptable session (aead error), so the re-login never happened (tars 2026-10-13)
    "$PASS_CLI" logout --force &>/dev/null || true
    PROTON_PASS_PERSONAL_ACCESS_TOKEN="$(get_pat)" "$PASS_CLI" login &>/dev/null
fi

fetch_item() {  # fetch_item <item title>
    PROTON_PASS_AGENT_REASON="Git HTTPS credential for $host" \
        "$PASS_CLI" item view \
        --vault-name "HOMELAB" \
        --item-title "$1" \
        --field "$field" 2>/dev/null
}

# Per-host git tokens (opt-in, 2026-11-08): with `git config --global protonpass.hostItems true` the helper
# first reads "<item title> - <short hostname>" (e.g. "gitlab.home.elikesbikes.com - git credential - murph"),
# so every git push is traceable to its host. If that item does not exist yet it falls back to the shared
# item and logs a warning to syslog (tag git-credential-protonpass -> Graylog). Hosts without the setting
# use the shared item only, with no extra Proton lookup.
password=""
if [ "$(git config --global --get protonpass.hostItems 2>/dev/null)" = "true" ]; then
    short_host="$(hostname -s)"
    password=$(fetch_item "$item_title - $short_host")
    if [ -z "$password" ]; then
        logger -t git-credential-protonpass "host item '$item_title - $short_host' missing, using shared item for $host" 2>/dev/null || true
    fi
fi
if [ -z "$password" ]; then
    password=$(fetch_item "$item_title")
fi

if [ -z "$password" ]; then
    exit 1
fi

echo "protocol=https"
echo "host=$host"
echo "username=$username"
echo "password=$password"
