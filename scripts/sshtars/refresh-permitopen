#!/usr/bin/env python3
"""Rewrite every SSHTars device line's permitopen list from the host catalog.

Run on hailmary after the catalog note's hosts change:  ~/scripts/sshtars/refresh-permitopen
A device line is one whose command= runs ~/scripts/sshtars/broker. Only its permitopen options
change; the key, the forced command and every other line stay as they are. Backs up first.
Source: sshtars-ios repo tools/broker/refresh-permitopen.
"""
import os, re, shutil, subprocess, sys, time

AK = os.path.expanduser("~/.ssh/authorized_keys")
CATALOG = os.path.join(os.path.dirname(os.path.abspath(__file__)), "catalog.py")

out = subprocess.run(["python3", CATALOG, "--permitopen"], capture_output=True, text=True)
if out.returncode != 0 or not out.stdout.startswith("permitopen="):
    sys.exit(f"catalog error, nothing changed: {out.stdout.strip() or out.stderr.strip()}")
permitopen = out.stdout.strip()

lines = open(AK).read().splitlines()
changed = 0
for i, line in enumerate(lines):
    if "/scripts/sshtars/broker" not in line or not line.startswith("restrict"):
        continue
    new = re.sub(r'(,permitopen="[^"]*")+', "," + permitopen, line, count=1)
    if new != line:
        lines[i] = new
        changed += 1

if not changed:
    print("device lines already match the catalog")
    sys.exit(0)
backup = f"{AK}.bak-sshtars-permitopen-{time.strftime('%Y%m%d-%H%M%S')}"
shutil.copy2(AK, backup)
tmp = AK + ".tmp"
with open(tmp, "w") as f:
    f.write("\n".join(lines) + "\n")
os.chmod(tmp, 0o600)
os.replace(tmp, AK)
print(f"updated {changed} device line(s); {permitopen.count('permitopen=')} destinations; backup {os.path.basename(backup)}")
subprocess.run(["logger", "-t", "sshtars-broker", f"permitopen refreshed for {changed} device line(s)"])
