#!/usr/bin/env bash
# CheckMK local check (endurance): the GitLab shell runner that deploys hermes/honcho/open-webui for the tutorials pipeline.
# It runs as the systemd USER service gitlab-runner-proton.service of ecloaiza (since 2026-11-08): the token comes from
# Proton Pass and config.toml lives only in RAM (/run/user/<uid>/gitlab-runner/). CRIT if the runner is not running;
# WARN if the RAM config is not mode 600, if a token file is back on disk (~/.gitlab-runner/config.toml), or if the
# runner reported "Failed to process runner" 3+ times in the last 10 minutes.
U=ecloaiza
UID_U="$(id -u "$U")"
if ! pgrep -u "$U" -f "gitlab-runner run" >/dev/null 2>&1; then
  echo "2 \"GitLab runner\" - not running (user service gitlab-runner-proton of $U)"; exit 0
fi
mode="$(stat -c %a "/run/user/$UID_U/gitlab-runner/config.toml" 2>/dev/null)"
fails="$(journalctl "_UID=$UID_U" --since "-10min" -q --no-pager 2>/dev/null | grep -c "Failed to process runner")"
st=0; msg="running, RAM config mode ${mode:-?}, ${fails} processing failures in 10 min"
[ "$mode" != "600" ] && { st=1; msg="$msg - /run/user/$UID_U/gitlab-runner/config.toml must exist with mode 600"; }
[ -e "/home/$U/.gitlab-runner/config.toml" ] && { st=1; msg="$msg - token file on disk: /home/$U/.gitlab-runner/config.toml"; }
[ "${fails:-0}" -ge 3 ] && { st=1; msg="$msg - jobs are failing to start"; }
echo "$st \"GitLab runner\" failures=${fails:-0};3 $msg"
