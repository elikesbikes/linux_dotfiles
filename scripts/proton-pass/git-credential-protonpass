#!/usr/bin/env bash
# Git credential helper that reads credentials from Proton Pass via PAT

if [ "$1" != "get" ]; then
    exit 0
fi

host=""
while IFS='=' read -r key value; do
    case "$key" in
        host) host="$value" ;;
    esac
done

case "$host" in
    github.com)
        item_title="github.com - git credential"
        username="elikesbikes"
        field="password"
        ;;
    gitlab.home.elikesbikes.com)
        item_title="gitlab.home.elikesbikes.com - git credential"
        username="ecloaiza"
        field="note"
        ;;
    *)
        exit 0
        ;;
esac

PASS_CLI="$HOME/.local/bin/pass-cli"
PAT_FILE="$HOME/.secrets/proton-pass-pat"
TPM_HANDLE="0x81010001"
export PROTON_PASS_SESSION_DIR="/tmp/pass-agent-git"
mkdir -p "$PROTON_PASS_SESSION_DIR"

get_pat() {
    if command -v tpm2_unseal &>/dev/null && tpm2_unseal -c "$TPM_HANDLE" 2>/dev/null; then
        return
    fi
    if [[ -f "$PAT_FILE" ]]; then
        cat "$PAT_FILE"
        return
    fi
    exit 1
}

if ! "$PASS_CLI" info &>/dev/null; then
    "$PASS_CLI" logout &>/dev/null || true
    PROTON_PASS_PERSONAL_ACCESS_TOKEN="$(get_pat)" "$PASS_CLI" login &>/dev/null
fi

password=$(PROTON_PASS_AGENT_REASON="Git HTTPS credential for $host" \
    "$PASS_CLI" item view \
    --vault-name "HOMELAB" \
    --item-title "$item_title" \
    --field "$field" 2>/dev/null)

if [ -z "$password" ]; then
    exit 1
fi

echo "protocol=https"
echo "host=$host"
echo "username=$username"
echo "password=$password"
