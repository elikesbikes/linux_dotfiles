#!/usr/bin/env python3
"""sshtars-hook: a host's agents and scripts → MCC → the SSHTars iPhone app (Inbox + push).

Clean-room take on Moshi's moshi-hook (docs/moshi-teardown.md §4), without a daemon or a cloud relay:
every call is one short HTTP request to the MCC runner on hailmary, and the only long-lived process is
the per-approval watcher below.

  sshtars-hook claude-hook            Claude Code hook entry point (Notification, Stop); reads its JSON on stdin
  sshtars-hook notify MSG [--title T] post to the Inbox and push it (--quiet: Inbox only)
  sshtars-hook ask QUESTION [--options a,b] [--timeout S] [--require-remote]
                                      block until the phone answers: exit 0 approved (prints the choice),
                                      1 denied, 3 expired, 4 error (falls back to a terminal y/N unless
                                      --require-remote)
  sshtars-hook doctor                 check URL, token and the route; prints no secret
  sshtars-hook install-claude         add its hooks to ~/.claude/settings.json (keeps every other hook)
  sshtars-hook uninstall-claude       remove only its own hooks

Terminals: tmux, herdr and herdr-core (`hc`, what the Herdr app runs). Events carry the terminal so the
app can open it, and "finished" pushes only when nobody has looked: tmux by keystrokes, herdr and
herdr-core by their own seen state (see unseen()). A plain terminal gets Inbox entries, no target.

Approvals for Claude Code: when Claude Code has shown a permission prompt for ~6 s without an answer it
fires the Notification hook (`notification_type: permission_prompt`). This hook then reads the prompt
from the terminal's screen, posts it as an approval, and leaves a detached watcher behind. The terminal
prompt stays usable the whole time. The watcher polls MCC; on the phone's answer it re-reads the screen
and, only if the same prompt is still there (and herdr or herdr-core still report the agent blocked),
presses Enter (the highlighted "Yes") or Escape ("No"). If the prompt goes away first (answered at the
desk), the approval is closed on MCC.

Credentials: the host's own MCC caller token (`sshtars-hook-<host>`), read at run time from Proton Pass
item "MCC - MCC_TOKEN_SSHTARS_HOOK_<HOST>" through ~/scripts/proton-pass/pass-secrets.sh (TPM-sealed PAT
and cache, every read logged to syslog → Graylog). SSHTARS_HOOK_TOKEN in the environment overrides it
for tests. Nothing is written to disk but a log of outcomes (~/.local/state/sshtars-hook/hook.log).

A hook must never break the agent: every failure is logged and the hook exits 0 with no output.
"""
import argparse
import json
import os
import re
import shutil
import socket
import subprocess
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path

VERSION = "1.2.0"
DEFAULT_URL = "http://192.168.5.25:5679"          # the MCC runner on hailmary (token judged on the TCP peer)
STATE = Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state") / "sshtars-hook"
LOG = STATE / "hook.log"
PASS_SECRETS = Path.home() / "scripts/proton-pass/pass-secrets.sh"
AWAY_S = int(os.environ.get("SSHTARS_HOOK_AWAY_S", "60"))          # no keystroke in the session for this long = away
APPROVAL_TTL_S = int(os.environ.get("SSHTARS_HOOK_APPROVAL_TTL_S", "1800"))
POLL_S = 2.0
SEEN_WAIT_S = int(os.environ.get("SSHTARS_HOOK_SEEN_WAIT_S", "20"))   # herdr/hc: time to look before a push
PROMPT_RE = re.compile(r"Do you want to (proceed|make this edit|create|allow|run)", re.I)
OPTION_RE = re.compile(r"^\s*[❯>]?\s*\d\.\s+\S")


# ------------------------------------------------------------------ plumbing

def host_name() -> str:
    return socket.gethostname().split(".")[0].lower()


def log(outcome: str, **fields):
    try:
        STATE.mkdir(parents=True, exist_ok=True)
        line = {"ts": round(time.time(), 3), "pid": os.getpid(), "outcome": outcome, **fields}
        with open(LOG, "a") as f:
            f.write(json.dumps(line, ensure_ascii=False)[:2000] + "\n")
    except OSError:
        pass


def config() -> dict:
    return {"url": os.environ.get("SSHTARS_HOOK_URL", DEFAULT_URL).rstrip("/"),
            "item": os.environ.get("SSHTARS_HOOK_ITEM", f"MCC - MCC_TOKEN_SSHTARS_HOOK_{host_name().upper()}")}


_token_cache = None


def token(cfg) -> str:
    """The host's MCC token: env override, else Proton Pass through pp_load (cache fresh for an hour)."""
    global _token_cache
    if _token_cache:
        return _token_cache
    env = os.environ.get("SSHTARS_HOOK_TOKEN", "").strip()
    if env:
        _token_cache = env
        return env
    if not PASS_SECRETS.exists():
        raise RuntimeError(f"no token: SSHTARS_HOOK_TOKEN unset and {PASS_SECRETS} missing")
    script = ('source "$1"; PP_FRESH_S="${PP_FRESH_S:-3600}" pp_load sshtars-hook "sshtars-hook token" '
              '"SSHTARS_HOOK_TOKEN|$2|note" >/dev/null || exit 1; printf %s "$SSHTARS_HOOK_TOKEN"')
    r = subprocess.run(["bash", "-c", script, "_", str(PASS_SECRETS), cfg["item"]],
                       capture_output=True, text=True, timeout=60)
    value = r.stdout.strip()
    if r.returncode != 0 or not value:
        raise RuntimeError(f"Proton Pass item {cfg['item']!r} not loaded (pp_load exit {r.returncode}; see syslog tag proton-pass-load)")
    _token_cache = value
    return value


def api(method: str, path: str, body=None, cfg=None, timeout=10):
    cfg = cfg or config()
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(cfg["url"] + path, data=data, method=method)
    req.add_header("Authorization", f"Bearer {token(cfg)}")
    req.add_header("Accept", "application/json")
    if data is not None:
        req.add_header("Content-Type", "application/json")
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return json.loads(resp.read() or b"{}")
    except urllib.error.HTTPError as e:
        try:
            detail = json.loads(e.read() or b"{}").get("error", "")
        except ValueError:
            detail = ""
        raise RuntimeError(f"MCC {method} {path}: HTTP {e.code} {detail}".strip()) from None


# ------------------------------------------------------------------ terminals: tmux, herdr, herdr-core
#
# The terminal an agent runs in, as MCC stores it and the app opens it:
#   {"kind": "tmux",  "session": "agents", "window": "2", "pane": "%7"}
#   {"kind": "herdr", "session": "default", "workspace": "sshtars", "pane": "w1:p1"}
#   {"kind": "hc",    "workspace": "sshtars-ios", "pane": "t1g"}            (herdr-core, the Herdr app)
# tmux is checked first: it can run inside the other two, and its pane is the more precise address.
# herdr and hc are called without a session flag, so they talk to the session the agent inherited.

def run(argv, timeout=5) -> str:
    r = subprocess.run(argv, capture_output=True, text=True, timeout=timeout)
    if r.returncode != 0:
        raise RuntimeError(f"{' '.join(argv[:2])}: {(r.stderr or r.stdout).strip()[:200]}")
    return r.stdout


def tmux(*args, timeout=5) -> str:
    return run(["tmux", *args], timeout)


def herdr_result(*args) -> dict:
    data = json.loads(run(["herdr", *args]) or "{}")
    if data.get("error"):
        raise RuntimeError(f"herdr {' '.join(args[:2])}: {data['error'].get('code')}")
    return data.get("result") or {}


def hc_info(address: str) -> dict:
    return json.loads(run(["hc", "get", address, "--json"]) or "{}")


_FAILS = (RuntimeError, ValueError, subprocess.SubprocessError, OSError)


def tmux_terminal():
    pane = os.environ.get("TMUX_PANE")
    if not pane or not os.environ.get("TMUX") or not shutil.which("tmux"):
        return None
    try:
        out = tmux("display-message", "-p", "-t", pane, "#{session_name}|#{window_index}|#{pane_id}").strip()
        session, window, pane_id = out.split("|", 2)
        return {"kind": "tmux", "session": session, "window": window, "pane": pane_id}
    except _FAILS as e:
        log("tmux-target-failed", error=str(e))
        return None


def hc_terminal():
    address = os.environ.get("HC_TERMINAL_ID")
    if not address or not shutil.which("hc"):
        return None
    term = {"kind": "hc", "pane": address}
    try:
        info = hc_info(address)
        term["pane"] = info.get("address") or address
        where = (info.get("labels") or {}).get("where") or ""          # "tars / sshtars-ios"
        if where:
            term["workspace"] = where.split(" / ", 1)[-1]
    except _FAILS as e:
        log("hc-target-failed", error=str(e))
    return term


def herdr_terminal():
    pane = os.environ.get("HERDR_PANE_ID")
    if os.environ.get("HERDR_ENV") != "1" or not pane or not shutil.which("herdr"):
        return None
    workspace = os.environ.get("HERDR_WORKSPACE_ID")
    term = {"kind": "herdr", "session": os.environ.get("HERDR_SESSION") or "default", "pane": pane,
            "workspace": workspace}
    try:
        for w in herdr_result("workspace", "list").get("workspaces", []):
            if w.get("workspace_id") == workspace and w.get("label"):
                term["workspace"] = w["label"]
    except _FAILS as e:
        log("herdr-target-failed", error=str(e))
    return term


def terminal():
    """Where this process runs, or None in a plain terminal (then events carry no target)."""
    return tmux_terminal() or hc_terminal() or herdr_terminal()


def describe(term) -> str:
    if not term:
        return "plain terminal (no tmux, herdr or herdr-core)"
    where = term.get("session") or ""
    if term.get("window"):
        where += f":{term['window']}"
    if term.get("workspace"):
        where += (" / " if where else "") + term["workspace"]
    return f"{term['kind']} {where} pane {term['pane']}".replace("  ", " ")


def screen(term) -> list:
    """The visible screen of the terminal, as lines."""
    if term["kind"] == "tmux":
        return tmux("capture-pane", "-p", "-t", term["pane"]).splitlines()
    if term["kind"] == "hc":
        return run(["hc", "read", term["pane"]]).splitlines()
    return run(["herdr", "pane", "read", term["pane"], "--source", "visible"]).splitlines()


def press(term, key: str):
    """key: "enter" or "esc"."""
    if term["kind"] == "tmux":
        tmux("send-keys", "-t", term["pane"], "Enter" if key == "enter" else "Escape")
    elif term["kind"] == "hc":
        run(["hc", "keys", term["pane"], key])
    else:
        run(["herdr", "pane", "send-keys", term["pane"], key])


def agent_state(term):
    """What herdr-core or herdr says the agent is doing (idle, working, blocked, done, …); None for tmux,
    a plain terminal, or when it cannot be read. Both read it from the agent itself, not from the screen."""
    if not term or term["kind"] == "tmux":
        return None
    try:
        if term["kind"] == "hc":
            status = hc_info(term["pane"]).get("status")
            return status.get("state") if isinstance(status, dict) else status
        return herdr_result("pane", "get", term["pane"]).get("pane", {}).get("agent_status")
    except _FAILS as e:
        log("agent-state-failed", kind=term["kind"], error=str(e))
        return None


def last_activity(session: str) -> float:
    """Newest keystroke time of any client attached to the tmux `session` (0 when none is attached)."""
    try:
        values = [int(v) for v in tmux("list-clients", "-t", session, "-F", "#{client_activity}").split() if v.isdigit()]
    except _FAILS:
        return 0.0
    return float(max(values)) if values else 0.0


def is_away(term) -> bool:
    """tmux only: nobody typed in the session for AWAY_S, or no client is attached."""
    activity = last_activity(term["session"])
    return activity == 0 or time.time() - activity >= AWAY_S


def unseen(term) -> bool:
    """After a turn ends, should the phone be told? Runs in the detached child.

    tmux: nobody typed in the session for AWAY_S. herdr-core: after SEEN_WAIT_S the agent is still
    `done` and Herdr's `herdr.seen` turn is behind the terminal's turn (Herdr catches it up when someone
    looks at the terminal). herdr: still `done` after SEEN_WAIT_S (herdr turns it `idle` once viewed).
    A plain terminal has no signal: Inbox only, and Claude Code's idle_prompt reaches the phone if the
    turn sits unanswered."""
    if not term:
        return False
    if term["kind"] == "tmux":
        return is_away(term)
    time.sleep(SEEN_WAIT_S)
    try:
        if term["kind"] == "hc":
            info = hc_info(term["pane"])
            status = info.get("status")
            state = status.get("state") if isinstance(status, dict) else status
            if state != "done":
                return False          # working again (someone typed) or blocked (that sends its own notice)
            seen = int((info.get("labels") or {}).get("herdr.seen", -1))
            return seen < int(info.get("turn") or 0)
        return agent_state(term) == "done"
    except _FAILS as e:
        log("seen-check-failed", kind=term["kind"], error=str(e))
        return True


def prompt_block(lines: list):
    """The permission prompt on screen: up to 8 lines above "Do you want to …" and its numbered
    options. None when no prompt is showing."""
    idx = [i for i, line in enumerate(lines) if PROMPT_RE.search(line)]
    if not idx:
        return None
    at = idx[-1]
    end = at + 1
    while end < len(lines) and (OPTION_RE.match(lines[end]) or not lines[end].strip()) and end - at < 8:
        end += 1
    options = [l for l in lines[at + 1:end] if OPTION_RE.match(l)]
    if not options:
        return None
    start = at
    while start > 0 and at - start < 8 and lines[start - 1].strip() and not set(lines[start - 1].strip()) <= set("─━-╭╮╰╯│ "):
        start -= 1
    return {"context": [l.strip(" │") for l in lines[start:at] if l.strip(" │")],
            "question": lines[at].strip(" │"), "options": [o.strip(" │") for o in options]}


def same_prompt(a, b) -> bool:
    return bool(a and b) and a["question"] == b["question"] and \
        [re.sub(r"^[❯>]\s*", "", o) for o in a["options"]] == [re.sub(r"^[❯>]\s*", "", o) for o in b["options"]]


# ------------------------------------------------------------------ events

def post_event(kind, title, body=None, *, target=None, push=True, **extra):
    payload = {"kind": kind, "title": title[:200], "body": (body or "")[:1500], "push": push,
               "tmux": target, **{k: v for k, v in extra.items() if v is not None}}
    return api("POST", "/api/sshtars/hook/events", payload)


def detach(fn, *args):
    """Run fn(*args) in a detached grandchild (new session, stdio to /dev/null) and return at once."""
    if os.fork() != 0:
        return
    os.setsid()
    if os.fork() != 0:
        os._exit(0)
    fd = os.open(os.devnull, os.O_RDWR)
    for n in (0, 1, 2):
        os.dup2(fd, n)
    try:
        fn(*args)
    except Exception as e:  # the watcher's last word goes to the log; nobody else is listening
        log("detached-failed", error=f"{type(e).__name__}: {e}")
    os._exit(0)


def watch_approval(event_id: str, term: dict, prompt: dict, expires: float):
    """Poll MCC for the phone's answer and type it into the terminal, but only into the same prompt
    (and, in herdr or herdr-core, only while the agent still says it is blocked)."""
    log("watch-start", event=event_id, terminal=describe(term))
    while time.time() < expires:
        time.sleep(POLL_S)
        try:
            now = prompt_block(screen(term))
        except _FAILS:
            now = None
        if not same_prompt(prompt, now):
            api("POST", f"/api/sshtars/hook/events/{event_id}/close", {"reason": "answered at the terminal"})
            log("watch-closed", event=event_id, reason="prompt gone")
            return
        try:
            state = api("GET", f"/api/sshtars/hook/events/{event_id}")
        except RuntimeError as e:
            log("watch-poll-failed", event=event_id, error=str(e))
            continue
        status = state.get("status")
        if status in ("approved", "denied"):
            state = agent_state(term)
            if state not in (None, "blocked"):
                api("POST", f"/api/sshtars/hook/events/{event_id}/close", {"reason": f"agent is {state}, not waiting"})
                log("watch-closed", event=event_id, reason=f"agent {state}")
                return
            press(term, "enter" if status == "approved" else "esc")
            log("watch-applied", event=event_id, status=status)
            return
        if status not in ("pending",):
            log("watch-ended", event=event_id, status=status)
            return
    api("POST", f"/api/sshtars/hook/events/{event_id}/close", {"reason": "expired on the host"})
    log("watch-expired", event=event_id)


# ------------------------------------------------------------------ Claude Code

def claude_hook(stdin_text: str):
    data = json.loads(stdin_text or "{}")
    event = data.get("hook_event_name", "")
    cwd = data.get("cwd") or os.getcwd()
    project = Path(cwd).name or cwd
    target = terminal()

    if event == "Notification":
        kind = data.get("notification_type", "")
        if kind == "permission_prompt":
            permission_prompt(data, cwd, project, target)
        elif kind in ("idle_prompt", "elicitation_dialog", "agent_needs_input"):
            # Claude Code fires these only after the prompt has sat unanswered, which is itself the
            # "nobody is at the desk" signal, so they always push.
            msg = data.get("message") or "Claude is waiting for your input"
            detach(lambda: post_event("notify", f"Claude is waiting · {project}", msg, target=target,
                                      push=True, cwd=cwd, agent="claude", category="waiting"))
        return
    if event == "Stop":
        if data.get("stop_hook_active"):
            return
        text = (data.get("last_assistant_message") or "").strip()
        # Every turn ends in Stop, so it pushes only when nobody has looked (see unseen()); the
        # detached child does the waiting, so the agent is never held up.
        detach(lambda: post_event("notify", f"Claude finished · {project}", text[-600:], target=target,
                                  push=unseen(target), cwd=cwd, agent="claude", category="task_complete"))


def permission_prompt(data, cwd, project, target):
    message = data.get("message") or "Claude needs your permission"
    prompt = None
    if target:
        try:
            prompt = prompt_block(screen(target))
        except _FAILS as e:
            log("capture-failed", kind=target["kind"], error=str(e))
    if not prompt:
        # A plain terminal, or the prompt is not on screen: the phone can only be told, not answer.
        detach(lambda: post_event("notify", f"Claude needs approval · {project}",
                                  f"{message}. Answer it at the terminal.", target=target, cwd=cwd,
                                  agent="claude", category="approval_required"))
        return
    body = "\n".join(prompt["context"][-6:] + [prompt["question"]])
    expires = time.time() + APPROVAL_TTL_S

    def run():
        created = post_event("approval", f"Claude needs approval · {project}", body, target=target, cwd=cwd,
                             agent="claude", tool=message, expires_s=APPROVAL_TTL_S,
                             category="approval_required")
        watch_approval(created["id"], target, prompt, expires)
    detach(run)


# ------------------------------------------------------------------ scripts

def cmd_notify(args):
    target = terminal()
    r = post_event("notify", args.title or args.message[:80], args.message if args.title else "",
                   target=target, push=not args.quiet, agent="script", category="notify")
    print(f"posted {r.get('id')} (push: {r.get('pushed')})")


def cmd_ask(args):
    options = [o.strip() for o in (args.options or "").split(",") if o.strip()]
    try:
        r = post_event("approval", args.question, args.detail or "", target=terminal(), agent="script",
                       options=options or None, expires_s=args.timeout, category="ask")
    except Exception as e:
        log("ask-failed", error=str(e))
        if args.require_remote or not sys.stdin.isatty():
            print(f"sshtars-hook: {e}", file=sys.stderr)
            return 4
        answer = input(f"{args.question} [y/N] ").strip().lower()
        return 0 if answer in ("y", "yes") else 1
    deadline = time.time() + args.timeout
    while time.time() < deadline:
        time.sleep(POLL_S)
        try:
            state = api("GET", f"/api/sshtars/hook/events/{r['id']}")
        except RuntimeError as e:
            log("ask-poll-failed", error=str(e))
            continue
        if state.get("status") == "approved":
            if state.get("choice"):
                print(state["choice"])
            return 0
        if state.get("status") == "denied":
            return 1
        if state.get("status") not in ("pending",):
            return 3
    return 3


def cmd_doctor(_args):
    cfg = config()
    print(f"host        {host_name()}")
    print(f"url         {cfg['url']}")
    print(f"token item  {cfg['item']}" + ("  (overridden by SSHTARS_HOOK_TOKEN)" if os.environ.get("SSHTARS_HOOK_TOKEN") else ""))
    target = terminal()
    extra = ""
    if target and target["kind"] == "tmux":
        extra = f"  away={is_away(target)}"
    elif target:
        extra = f"  agent={agent_state(target) or 'unknown'}"
    print(f"terminal    {describe(target)}{extra}")
    try:
        token(cfg)
        print("token       loaded")
    except Exception as e:
        print(f"token       FAILED: {e}")
        return 1
    try:
        me = api("GET", "/api/sshtars/hook/whoami")
        print(f"mcc         ok, this host is {me.get('host')!r}, {me.get('devices', 0)} phone(s) registered")
    except Exception as e:
        print(f"mcc         FAILED: {e}")
        return 1
    return 0


def last_logged():
    """The newest line of hook.log as {ts, outcome}, reading only the file's tail."""
    try:
        with open(LOG, "rb") as f:
            f.seek(0, os.SEEK_END)
            size = f.tell()
            f.seek(max(0, size - 4096))
            lines = f.read().decode("utf-8", "replace").strip().splitlines()
        for line in reversed(lines):
            try:
                row = json.loads(line)
                return {"ts": row.get("ts"), "outcome": row.get("outcome")}
            except ValueError:
                continue
    except OSError:
        pass
    return None


def cmd_status(args):
    """What the app's connect probe reads: quick and offline (no Proton Pass, no MCC call)."""
    settings = {}
    try:
        settings = json.loads(SETTINGS.read_text())
    except (OSError, ValueError):
        pass
    hooks = settings.get("hooks", {}) if isinstance(settings, dict) else {}
    wired = [e for e in EVENTS if any(_ours(x) for x in hooks.get(e, []) if isinstance(x, dict))]
    source = "env" if os.environ.get("SSHTARS_HOOK_TOKEN") else ("proton" if PASS_SECRETS.exists() else "missing")
    status = {"version": VERSION, "host": host_name(), "claude": len(wired) == len(EVENTS), "claude_events": wired,
              "token": source, "last": last_logged()}
    if args.json:
        print(json.dumps(status, ensure_ascii=False))
    else:
        last = status["last"]
        print(f"version     {VERSION}")
        print(f"claude      {'installed' if status['claude'] else 'not installed'} ({', '.join(wired) or 'no events'})")
        print(f"token       {source}")
        print("last        " + (f"{last['outcome']} at {time.strftime('%Y-%m-%d %H:%M:%S', time.localtime(last['ts']))}" if last and last.get("ts") else "nothing logged"))
    return 0


# ------------------------------------------------------------------ install

SETTINGS = Path.home() / ".claude/settings.json"
EVENTS = {"Notification": None, "Stop": None}


def _ours(entry) -> bool:
    return any("sshtars-hook" in (h.get("command") or "") for h in entry.get("hooks", []))


def cmd_install_claude(args, remove=False):
    exe = str(Path(args.exe or shutil.which("sshtars-hook") or sys.argv[0]).resolve())
    settings = json.loads(SETTINGS.read_text()) if SETTINGS.exists() else {}
    if SETTINGS.exists():
        backup = SETTINGS.with_name(f"settings.json.bak-sshtars-hook-{int(time.time())}")
        shutil.copy2(SETTINGS, backup)
        print(f"backup      {backup}")
    hooks = settings.setdefault("hooks", {})
    for event in EVENTS:
        entries = [e for e in hooks.get(event, []) if not _ours(e)]
        if not remove:
            entries.append({"hooks": [{"type": "command", "command": f"{exe} claude-hook", "timeout": 30}]})
        if entries:
            hooks[event] = entries
        else:
            hooks.pop(event, None)
    if not hooks:
        settings.pop("hooks", None)
    tmp = SETTINGS.with_suffix(".json.tmp")
    tmp.write_text(json.dumps(settings, indent=2) + "\n")
    tmp.replace(SETTINGS)
    print(("removed" if remove else "installed") + f"     {', '.join(EVENTS)} hooks in {SETTINGS}")
    return 0


def main(argv=None):
    p = argparse.ArgumentParser(prog="sshtars-hook", description=__doc__.split("\n")[0])
    p.add_argument("--version", action="version", version=VERSION)
    sub = p.add_subparsers(dest="cmd", required=True)
    sub.add_parser("claude-hook")
    n = sub.add_parser("notify"); n.add_argument("message"); n.add_argument("--title"); n.add_argument("--quiet", action="store_true")
    a = sub.add_parser("ask"); a.add_argument("question"); a.add_argument("--detail"); a.add_argument("--options")
    a.add_argument("--timeout", type=int, default=600); a.add_argument("--require-remote", action="store_true")
    sub.add_parser("doctor")
    st = sub.add_parser("status"); st.add_argument("--json", action="store_true")
    i = sub.add_parser("install-claude"); i.add_argument("--exe")
    u = sub.add_parser("uninstall-claude"); u.add_argument("--exe")
    args = p.parse_args(argv)

    if args.cmd == "claude-hook":
        # Never break the agent: whatever happens, exit 0 with nothing on stdout.
        try:
            claude_hook(sys.stdin.read())
        except Exception as e:
            log("claude-hook-failed", error=f"{type(e).__name__}: {e}")
        return 0
    if args.cmd == "notify":
        cmd_notify(args); return 0
    if args.cmd == "ask":
        return cmd_ask(args)
    if args.cmd == "doctor":
        return cmd_doctor(args)
    if args.cmd == "status":
