#!/usr/bin/env bash
# CheckMK local check (endurance): Honcho memory queue backlog and API health. WARN above 50 pending work units, CRIT above 500 or API down.
# Honcho login is on (2026-11-08): the queue call needs a key. The check makes a 60-second workspace key INSIDE the
# container with Honcho's own create_jwt and the container's AUTH_JWT_SECRET, so the secret never leaves the container
# and no key is stored anywhere. /health needs no key.
docker inspect -f '{{.State.Running}}' honcho-api 2>/dev/null | grep -q true || exit 0
res="$(docker exec -w /app honcho-api /app/.venv/bin/python -c '
import datetime,json,urllib.request
try:
    urllib.request.urlopen("http://localhost:8000/health",timeout=5).read()
    from src.security import JWTParams, create_jwt
    key=create_jwt(JWTParams(w="hermes",exp=datetime.datetime.now(datetime.timezone.utc)+datetime.timedelta(seconds=60)))
    req=urllib.request.Request("http://localhost:8000/v3/workspaces/hermes/queue/status",headers={"Authorization":"Bearer "+key})
    d=json.load(urllib.request.urlopen(req,timeout=10))
    print(d["pending_work_units"],d["in_progress_work_units"],d["completed_work_units"])
except Exception as e:
    print("ERR",type(e).__name__)
' 2>/dev/null)"
case "$res" in
  ERR*|"") echo "2 \"Honcho API\" - not answering ($res)"; exit 0 ;;
esac
read -r pending inprog done <<<"$res"
st=0; [ "$pending" -gt 50 ] && st=1; [ "$pending" -gt 500 ] && st=2
echo "$st \"Honcho memory queue\" pending=$pending;50;500|in_progress=$inprog|completed=$done pending $pending, in progress $inprog, completed $done"
