# Browser Preview: loopback listeners that answer HTTP with an HTML page. The app opens a same-port SSH
# forward (phone 127.0.0.1:P → host 127.0.0.1:P) and loads http://localhost:P, like Moshi's same-port rule:
# no path-prefix proxy, so dev-server websockets, redirects and cookies keep working.

LOOPBACK = {"127.0.0.1", "::1", "0.0.0.0", "::", "*"}
SKIP_PROCESSES = {"sshd", "ssh", "sshd-session", "systemd-resolve", "cupsd", "dnsmasq"}


def proc_address(hex_addr: str) -> str:
    """/proc/net/tcp{,6} local address ("0100007F" or 32 hex digits) → "127.0.0.1" / "::1" / "::"."""
    raw = bytes.fromhex(hex_addr)
    if len(raw) == 4:
        return socket.inet_ntop(socket.AF_INET, raw[::-1])
    # IPv6: four 32-bit words, each in the kernel's (little-endian) byte order.
    words = b"".join(raw[i:i + 4][::-1] for i in range(0, 16, 4))
    addr = socket.inet_ntop(socket.AF_INET6, words)
    return addr[7:] if addr.startswith("::ffff:") and "." in addr else addr


def parse_proc_net(text: str) -> list:
    """/proc/net/tcp or tcp6: [{"bind", "port", "inode"}] for listening sockets."""
    out = []
    for line in text.splitlines()[1:]:
        cols = line.split()
        if len(cols) < 10 or cols[3] != "0A":          # 0A = TCP_LISTEN
            continue
        addr, _, port = cols[1].partition(":")
        try:
            out.append({"bind": proc_address(addr), "port": int(port, 16), "inode": cols[9]})
        except (ValueError, OSError):
            continue
    return out


def socket_owners() -> dict:
    """socket inode → (process name, pid) for this user's processes (others' fds are not readable)."""
    owners = {}
    for pid in os.listdir("/proc"):
        if not pid.isdigit():
            continue
        try:
            fds = os.listdir(f"/proc/{pid}/fd")
            name = Path(f"/proc/{pid}/comm").read_text().strip()
        except OSError:
            continue
        for fd in fds:
            try:
                link = os.readlink(f"/proc/{pid}/fd/{fd}")
            except OSError:
                continue
            if link.startswith("socket:["):
                owners.setdefault(link[8:-1], (name, int(pid)))
    return owners


def proc_listeners() -> list:
    rows = []
    for name in ("tcp", "tcp6"):
        try:
            rows += parse_proc_net(Path(f"/proc/net/{name}").read_text())
        except OSError:
            pass
    owners = socket_owners() if rows else {}
    for r in rows:
        r["process"], r["pid"] = owners.get(r.pop("inode"), (None, None))
    return [r for r in rows if r["bind"] in LOOPBACK]


def parse_lsof(text: str) -> list:
    """`lsof -nP -iTCP -sTCP:LISTEN -Fpcn` (macOS)."""
    out, pid, process = [], None, None
    for line in text.splitlines():
        tag, value = line[:1], line[1:]
        if tag == "p":
            pid = int(value) if value.isdigit() else None
        elif tag == "c":
            process = value
        elif tag == "n":
            host, _, port = value.rpartition(":")
            host = host.strip("[]")
            if host in LOOPBACK and port.isdigit():
                out.append({"bind": host, "port": int(port), "process": process, "pid": pid})
    return out


def listeners() -> list:
    if Path("/proc/net/tcp").exists():                 # Linux: no ss or lsof needed (BusyBox has neither's flags)
        rows = proc_listeners()
    elif shutil.which("lsof"):                         # macOS
        rows = parse_lsof(run(["lsof", "-nP", "-iTCP", "-sTCP:LISTEN", "-Fpcn"], 10))
    else:
        raise RuntimeError("can't list listening ports here (no /proc/net/tcp, no lsof)")
    seen, out = set(), []
    for r in sorted(rows, key=lambda r: (r["port"], r["bind"] != "127.0.0.1")):
        if r["port"] in seen or r["port"] == 22 or (r["process"] or "") in SKIP_PROCESSES:
            continue
        seen.add(r["port"])
        out.append(r)
    return out[:64]


TITLE_RE = re.compile(rb"<title[^>]*>(.*?)</title>", re.I | re.S)


def probe_http(host: str, port: int, timeout=1.0):
    """GET / on the listener; the page's title when it answers with HTML, else None."""
    target = f"[{host}]" if ":" in host else host
    req = urllib.request.Request(f"http://{target}:{port}/", headers={"User-Agent": f"sshtars-hook/{VERSION}"})
    try:
        resp = urllib.request.urlopen(req, timeout=timeout)
    except urllib.error.HTTPError as e:
        resp = e
    except Exception:
        return None
    try:
        kind = (resp.headers.get("Content-Type") or "").lower()
        if "text/html" not in kind and "xhtml" not in kind:
            return None
        body = resp.read(32_768)
    except Exception:
        return None
    finally:
        try:
            resp.close()
        except Exception:
            pass
    m = TITLE_RE.search(body)
    title = re.sub(r"\s+", " ", m.group(1).decode("utf-8", "replace")).strip() if m else ""
    return title[:80]


def cmd_servers(args):
    import concurrent.futures
    rows = listeners()

    def check(r):
        host = "::1" if r["bind"] == "::1" else "127.0.0.1"
        title = probe_http(host, r["port"])
        return None if title is None else {"host": host, "port": r["port"], "title": title,
                                           "process": r["process"], "pid": r["pid"],
                                           "origin": f"http://localhost:{r['port']}"}

    with concurrent.futures.ThreadPoolExecutor(max_workers=16) as pool:
        servers = [s for s in pool.map(check, rows) if s]
    print(json.dumps({"version": VERSION, "servers": servers}, ensure_ascii=False))
    return 0


# Usage: Claude Code's plan limits, read the way Claude Code reads them — its own OAuth token from its own
# credential file, re-read every time, never copied, never refreshed (refreshing would rotate the token
# under Claude Code). The answer is cached for a minute so a busy app does not poll the API.

USAGE_URL = "https://api.anthropic.com/api/oauth/usage"
USAGE_CACHE = STATE / "usage.json"
USAGE_TTL_S = 60


def claude_token() -> str:
    base = Path(os.environ.get("CLAUDE_CONFIG_DIR") or Path.home() / ".claude")
    path = base / ".credentials.json"
    cred = None
    if path.exists():
        cred = json.loads(path.read_text()).get("claudeAiOauth")
    elif sys.platform == "darwin" and shutil.which("security"):
        try:
            cred = json.loads(run(["security", "find-generic-password", "-s", "Claude Code-credentials", "-w"])).get("claudeAiOauth")
        except (RuntimeError, ValueError):
            raise RuntimeError("Claude Code's sign-in is in the macOS Keychain, which is locked over SSH")
    if not cred or not cred.get("accessToken"):
        raise RuntimeError("Claude Code is not signed in with a Claude account on this host")
    expires = cred.get("expiresAt")
    if isinstance(expires, (int, float)) and expires / 1000 < time.time():
        raise RuntimeError("Claude Code's sign-in has expired; it renews the next time Claude Code runs")
    return cred["accessToken"], cred.get("subscriptionType")


def usage_windows(body: dict) -> list:
    """The API's limits as [{"label", "usedPercentage", "resetsAt"}], session first."""
    windows = []
    for limit in body.get("limits") or []:
        if not isinstance(limit, dict) or limit.get("percent") is None:
            continue
        kind = limit.get("kind") or ""
        model = ((limit.get("scope") or {}).get("model") or {}).get("display_name")
        label = {"session": "5h", "weekly_all": "7d"}.get(kind) or ("7d " + model if model else kind.replace("_", " "))
        windows.append({"label": label, "usedPercentage": round(float(limit["percent"])), "resetsAt": limit.get("resets_at")})
    if not windows:
        for key, label in (("five_hour", "5h"), ("seven_day", "7d"), ("seven_day_opus", "7d Opus"), ("seven_day_sonnet", "7d Sonnet")):
            w = body.get(key)
            if isinstance(w, dict) and w.get("utilization") is not None:
                windows.append({"label": label, "usedPercentage": round(float(w["utilization"])), "resetsAt": w.get("resets_at")})
    return windows


def claude_usage() -> dict:
    token, plan = claude_token()
    req = urllib.request.Request(USAGE_URL, headers={"Authorization": f"Bearer {token}", "Accept": "application/json",
                                                     "anthropic-beta": "oauth-2025-04-20",
                                                     "User-Agent": f"sshtars-hook/{VERSION}"})
    try:
        with urllib.request.urlopen(req, timeout=10) as r:
            body = json.loads(r.read())
    except urllib.error.HTTPError as e:
        raise RuntimeError(f"the usage API answered {e.code}")
    return {"agent": "claude-code", "account": plan, "windows": usage_windows(body),
            "capturedAt": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())}


def cmd_usage(args):
    if not args.refresh:
        try:
            cached = json.loads(USAGE_CACHE.read_text())
            if time.time() - cached.get("ts", 0) < USAGE_TTL_S:
                print(json.dumps({"version": VERSION, **cached["reply"]}, ensure_ascii=False))
                return 0
        except (OSError, ValueError, KeyError):
            pass
    usage, errors = [], []
    try:
        usage.append(claude_usage())
    except Exception as e:
        errors.append({"agent": "claude-code", "error": str(e)})
    reply = {"host": host_name(), "usage": usage, "errors": errors}
    try:
        STATE.mkdir(parents=True, exist_ok=True)
        USAGE_CACHE.write_text(json.dumps({"ts": time.time(), "reply": reply}))
    except OSError:
        pass
    print(json.dumps({"version": VERSION, **reply}, ensure_ascii=False))
    return 0


# ------------------------------------------------------------------ install

SETTINGS = Path.home() / ".claude/settings.json"
EVENTS = {"Notification": 30, "Stop": 30, "UserPromptSubmit": 30, "SessionEnd": 5}   # event → hook timeout (s)


def _ours(entry) -> bool:
    return any("sshtars-hook" in (h.get("command") or "") for h in entry.get("hooks", []))


def cmd_install_claude(args, remove=False):
    exe = str(Path(args.exe or shutil.which("sshtars-hook") or sys.argv[0]).resolve())
    settings = json.loads(SETTINGS.read_text()) if SETTINGS.exists() else {}
    if SETTINGS.exists():
        backup = SETTINGS.with_name(f"settings.json.bak-sshtars-hook-{int(time.time())}")
        shutil.copy2(SETTINGS, backup)
        print(f"backup      {backup}")
    hooks = settings.setdefault("hooks", {})
    for event in EVENTS:
        entries = [e for e in hooks.get(event, []) if not _ours(e)]
        if not remove:
            entries.append({"hooks": [{"type": "command", "command": f"{exe} claude-hook", "timeout": EVENTS[event]}]})
        if entries:
            hooks[event] = entries
        else:
            hooks.pop(event, None)
    if not hooks:
        settings.pop("hooks", None)
    tmp = SETTINGS.with_suffix(".json.tmp")
    tmp.write_text(json.dumps(settings, indent=2) + "\n")
    tmp.replace(SETTINGS)
    print(("removed" if remove else "installed") + f"     {', '.join(EVENTS)} hooks in {SETTINGS}")
    return 0


def main(argv=None):
    p = argparse.ArgumentParser(prog="sshtars-hook", description=__doc__.split("\n")[0])
    p.add_argument("--version", action="version", version=VERSION)
    sub = p.add_subparsers(dest="cmd", required=True)
    sub.add_parser("claude-hook")
    n = sub.add_parser("notify"); n.add_argument("message"); n.add_argument("--title"); n.add_argument("--quiet", action="store_true")
    a = sub.add_parser("ask"); a.add_argument("question"); a.add_argument("--detail"); a.add_argument("--options")
    a.add_argument("--timeout", type=int, default=600); a.add_argument("--require-remote", action="store_true")
    sub.add_parser("doctor")
    st = sub.add_parser("status"); st.add_argument("--json", action="store_true")
    ss = sub.add_parser("sessions"); ss.add_argument("--json", action="store_true"); ss.add_argument("--limit", type=int, default=20)
    tr = sub.add_parser("transcript"); tr.add_argument("session"); tr.add_argument("--limit", type=int, default=80)
    tr.add_argument("--json", action="store_true")
    pr = sub.add_parser("prompt"); pr.add_argument("session"); pr.add_argument("text")
    d = sub.add_parser("diff"); d.add_argument("--json", action="store_true"); d.add_argument("--tmux"); d.add_argument("--cwd")
    sv = sub.add_parser("servers"); sv.add_argument("--json", action="store_true")
    us = sub.add_parser("usage"); us.add_argument("--json", action="store_true"); us.add_argument("--refresh", action="store_true")
    i = sub.add_parser("install-claude"); i.add_argument("--exe")
    u = sub.add_parser("uninstall-claude"); u.add_argument("--exe")
    args = p.parse_args(argv)

    if args.cmd == "claude-hook":
        # Never break the agent: whatever happens, exit 0 with nothing on stdout.
        try:
            claude_hook(sys.stdin.read())
        except Exception as e:
            log("claude-hook-failed", error=f"{type(e).__name__}: {e}")
        return 0
    if args.cmd == "notify":
        cmd_notify(args); return 0
    if args.cmd == "ask":
        return cmd_ask(args)
    if args.cmd == "doctor":
        return cmd_doctor(args)
    if args.cmd == "status":
        return cmd_status(args)
    if args.cmd == "sessions":
        return cmd_sessions(args)
    if args.cmd == "transcript":
        return cmd_transcript(args)
    if args.cmd == "prompt":
        return cmd_prompt(args)
    if args.cmd == "diff":
        return cmd_diff(args)
    if args.cmd == "servers":
        return cmd_servers(args)
    if args.cmd == "usage":
        return cmd_usage(args)
    if args.cmd == "install-claude":
        return cmd_install_claude(args)
    if args.cmd == "uninstall-claude":
        return cmd_install_claude(args, remove=True)
    return 2


if __name__ == "__main__":
    sys.exit(main())
