# ------------------------------------------------------------------ Chat View: sessions, transcript, prompt

SESSIONS = STATE / "sessions"
PROJECTS = Path.home() / ".claude/projects"
SESSION_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9-]{7,79}$")
RECENT_S = 3 * 86400


def record_session(data, target):
    """Remember which terminal a Claude Code session runs in, so `prompt` can type into it later."""
    sid = data.get("session_id") or ""
    if not SESSION_RE.match(sid) or data.get("agent_id"):
        return
    try:
        SESSIONS.mkdir(parents=True, exist_ok=True)
        tmp = SESSIONS / f".{sid}.tmp"
        title = data.get("session_title") or (registry_entry(sid) or {}).get("title")
        tmp.write_text(json.dumps({"session": sid, "transcript": data.get("transcript_path"), "cwd": data.get("cwd"),
                                   "terminal": target, "title": title, "ts": round(time.time(), 3)}))
        tmp.replace(SESSIONS / f"{sid}.json")
    except OSError as e:
        log("session-record-failed", error=str(e))


def registry_entry(sid: str):
    try:
        return json.loads((SESSIONS / f"{sid}.json").read_text())
    except (OSError, ValueError):
        return None


def registry() -> dict:
    out = {}
    for f in SESSIONS.glob("*.json") if SESSIONS.exists() else []:
        try:
            entry = json.loads(f.read_text())
            out[entry["session"]] = entry
        except (OSError, ValueError, KeyError):
            continue
    return out


def transcript_path(sid: str, reg=None):
    entry = (reg if reg is not None else registry()).get(sid) or {}
    path = entry.get("transcript")
    if path and Path(path).is_file():
        return Path(path)
    for p in PROJECTS.glob(f"*/{sid}.jsonl"):
        return p
    return None


def tail_rows(path: Path, max_bytes: int) -> list:
    """The JSONL's last max_bytes as parsed rows (the first, partial line dropped when cut)."""
    with open(path, "rb") as f:
        f.seek(0, os.SEEK_END)
        size = f.tell()
        f.seek(max(0, size - max_bytes))
        lines = f.read().split(b"\n")
    if size > max_bytes:
        lines = lines[1:]
    rows = []
    for line in lines:
        try:
            rows.append(json.loads(line))
        except ValueError:
            continue
    return rows


REMINDER_RE = re.compile(r"<system-reminder>.*?</system-reminder>", re.S)


def tool_summary(name: str, value) -> str:
    """One line for a tool call: the command, path, pattern or URL it was given."""
    value = value if isinstance(value, dict) else {}
    keys = {"Bash": "command", "Read": "file_path", "Edit": "file_path", "Write": "file_path", "MultiEdit": "file_path",
            "NotebookEdit": "notebook_path", "Grep": "pattern", "Glob": "pattern", "WebFetch": "url", "WebSearch": "query",
            "Task": "description", "Agent": "description", "Skill": "skill", "TodoWrite": None}
    key = keys.get(name, "")
    text = value.get(key) if key else None
    if text is None and key == "":
        text = next((v for v in value.values() if isinstance(v, str)), "")
    return " ".join(str(text or "").split())[:200]


def reduce_transcript(rows: list, limit: int) -> dict:
    """Claude Code JSONL rows → title, model, branch, state and the last `limit` chat rows."""
    msgs, tools = [], {}
    title = prompt_title = model = branch = cwd = context = None
    state = "idle"
    for r in rows:
        kind = r.get("type")
        if kind == "custom-title":
            title = r.get("customTitle") or title
            continue
        if kind == "last-prompt":
            prompt_title = r.get("lastPrompt") or prompt_title
            continue
        if kind not in ("user", "assistant") or r.get("isSidechain"):
            continue
        cwd = r.get("cwd") or cwd
        branch = r.get("gitBranch") or branch
        message = r.get("message") or {}
        content = message.get("content")
        ts = r.get("timestamp")
        uid = r.get("uuid") or str(len(msgs))
        if kind == "user":
            if r.get("isMeta"):
                continue
            blocks = content if isinstance(content, list) else []
            for b in blocks:
                if isinstance(b, dict) and b.get("type") == "tool_result":
                    tool = tools.get(b.get("tool_use_id"))
                    if tool is not None:
                        tool["ok"] = not b.get("is_error")
                    state = "working"
            text = content if isinstance(content, str) else "\n".join(
                b.get("text", "") for b in blocks if isinstance(b, dict) and b.get("type") == "text")
            text = REMINDER_RE.sub("", text).strip()
            if text and not text.startswith("<"):
                msgs.append({"id": uid, "role": "user", "text": text[:4000], "ts": ts})
                state = "working"
            continue
        model = message.get("model") or model
        usage = message.get("usage")
        if isinstance(usage, dict):         # tokens the model saw this turn = how full the context is
            seen = sum(int(usage.get(k) or 0) for k in
                       ("input_tokens", "cache_creation_input_tokens", "cache_read_input_tokens"))
            context = seen or context
        for i, b in enumerate(content if isinstance(content, list) else []):
            if not isinstance(b, dict):
                continue
            if b.get("type") == "text" and b.get("text", "").strip():
                text = REMINDER_RE.sub("", b["text"]).strip()
                if msgs and msgs[-1]["role"] == "assistant" and msgs[-1].get("mid") == message.get("id"):
                    msgs[-1]["text"] = (msgs[-1]["text"] + "\n\n" + text)[:8000]
                else:
                    msgs.append({"id": f"{uid}.{i}", "role": "assistant", "text": text[:8000], "ts": ts, "mid": message.get("id")})
            elif b.get("type") == "tool_use":
                row = {"id": f"{uid}.{i}", "role": "tool", "tool": b.get("name") or "tool",
                       "text": tool_summary(b.get("name") or "", b.get("input")), "ok": None, "ts": ts}
                tools[b.get("id")] = row
                msgs.append(row)
        stop = message.get("stop_reason")
        if stop:
            state = "working" if stop == "tool_use" else "idle"
    for m in msgs:
        m.pop("mid", None)
    if model and model.startswith("<"):
        model = None
    first_prompt = next((m["text"] for m in msgs if m["role"] == "user"), None)
    return {"title": title or prompt_title or first_prompt, "model": model, "branch": branch, "cwd": cwd,
            "state": state, "context": context, "messages": msgs[-limit:]}


def session_info(sid: str, path: Path, reg: dict, rows_bytes: int, limit: int) -> dict:
    info = reduce_transcript(tail_rows(path, rows_bytes), limit)
    mtime = path.stat().st_mtime
    if info["state"] == "working" and time.time() - mtime > 600:
        info["state"] = "idle"              # a turn that stopped writing 10 min ago is not running
    term = (reg.get(sid) or {}).get("terminal")
    title = " ".join((info["title"] or "").split())[:120]
    return {"session": sid, "title": title, "cwd": info["cwd"], "project": Path(info["cwd"] or "").name or None,
            "model": info["model"], "branch": info["branch"], "state": info["state"], "updated": round(mtime, 3),
            "context": info["context"],
            "terminal": term, "where": describe(term) if term else None, "messages": info["messages"]}


def cmd_sessions(args):
    reg = registry()
    found = {}
    for sid in reg:
        path = transcript_path(sid, reg)
        if path:
            found[sid] = path
    cutoff = time.time() - RECENT_S
    for p in PROJECTS.glob("*/*.jsonl") if PROJECTS.exists() else []:
        try:
            if p.stat().st_mtime >= cutoff and SESSION_RE.match(p.stem):
                found.setdefault(p.stem, p)
        except OSError:
            continue
    ordered = sorted(found.items(), key=lambda kv: kv[1].stat().st_mtime, reverse=True)[:args.limit]
    out = []
    for sid, path in ordered:
        try:
            info = session_info(sid, path, reg, 400_000, 30)
        except (OSError, ValueError) as e:
            log("session-read-failed", session=sid, error=str(e))
            continue
        said = [m for m in info.pop("messages") if m["role"] != "tool"]
        info["last"] = " ".join(said[-1]["text"].split())[:200] if said else None
        out.append(info)
    if args.json:
        print(json.dumps({"version": VERSION, "sessions": out}, ensure_ascii=False))
    else:
        for s in out:
            print(f"{s['session'][:8]}  {s['state']:7}  {s['where'] or '-':32}  {s['title']}")
    return 0


def cmd_transcript(args):
    if not SESSION_RE.match(args.session):
        print(json.dumps({"error": "bad session id"})); return 2
    reg = registry()
    path = transcript_path(args.session, reg)
    if not path:
        print(json.dumps({"error": "no transcript for this session"})); return 1
    info = session_info(args.session, path, reg, 3_000_000, max(1, min(args.limit, 300)))
    print(json.dumps({"version": VERSION, **info}, ensure_ascii=False))
    return 0


CONTROL_RE = re.compile(r"[\x00-\x1f\x7f]")


def type_into(term: dict, text: str):
    """Type text into the terminal and press Enter: the same thing a person at the keyboard does."""
    if term["kind"] == "tmux":
        tmux("send-keys", "-t", term["pane"], "-l", text)
        tmux("send-keys", "-t", term["pane"], "Enter")
    elif term["kind"] == "hc":
        run(["hc", "send", term["pane"], text])
    else:
        session = term.get("session") or "default"
        herdr = ["herdr"] if session == "default" else ["herdr", "--session", session]
        run([*herdr, "pane", "send-text", term["pane"], text])
        run([*herdr, "pane", "send-keys", term["pane"], "enter"])


def cmd_prompt(args):
    if not SESSION_RE.match(args.session):
        print("bad session id", file=sys.stderr); return 2
    text = " ".join(CONTROL_RE.sub(" ", args.text).split())
    if not text:
        print("nothing to send", file=sys.stderr); return 2
    term = (registry().get(args.session) or {}).get("terminal")
    if not term:
        print("no terminal known for this session yet (recorded when one of its turns ends)", file=sys.stderr)
        return 1
    try:
        type_into(term, text[:4000])
    except _FAILS as e:
        log("prompt-failed", session=args.session, error=str(e))
        print(f"could not type into {describe(term)}: {e}", file=sys.stderr)
        return 1
    log("prompt-sent", session=args.session, terminal=describe(term), chars=len(text))
    print(json.dumps({"ok": True, "where": describe(term)}))
    return 0


def last_logged():
    """The newest line of hook.log as {ts, outcome}, reading only the file's tail."""
    try:
        with open(LOG, "rb") as f:
            f.seek(0, os.SEEK_END)
            size = f.tell()
            f.seek(max(0, size - 4096))
            lines = f.read().decode("utf-8", "replace").strip().splitlines()
        for line in reversed(lines):
            try:
                row = json.loads(line)
                return {"ts": row.get("ts"), "outcome": row.get("outcome")}
            except ValueError:
                continue
    except OSError:
        pass
    return None


